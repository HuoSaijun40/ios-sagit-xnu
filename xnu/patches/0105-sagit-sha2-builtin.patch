new file mode 100644
index 0000000..3233b18
--- /dev/null
+++ b/bsd/dev/sagit_sha2.c
@@ -0,0 +1,460 @@
+/*
+ * SAGIT: SHA-1, SHA-256, SHA-384 and SHA-512, in kernel.
+ *
+ * 0077 installed a crypto_functions table that carried MD5 only. This port has
+ * no corecrypto, and none of osfmk/corecrypto's ccdigest objects are linked
+ * into the kernel (the built kernel has no ccsha256_di, no ccdigest_init, no
+ * ccsha256_ltc_compress), so every SHA member of that table stayed NULL.
+ *
+ * The first code-signing hash then jumped through SHA256_Init ->
+ * g_crypto_funcs->ccsha256_di (NULL) and took a data abort at address 0:
+ *
+ *   panic: Kernel data abort at pc 0xfffffff00790a4a0
+ *          (_SHA256_Init+0x10), far 0x0
+ *
+ * These are plain FIPS 180-4 digests behind the ccdigest_info interface, so
+ * the corecrypto_sha*.c wrappers and the tables in bsd/kern/ubc_subr.c work
+ * unchanged. Only the digest half of crypto_functions is filled in; ciphers
+ * are still absent and will fault if something asks for one.
+ */
+
+#include <libkern/libkern.h>
+#include <corecrypto/ccdigest.h>
+#include <corecrypto/cc.h>
+
+/* SHA-384 and SHA-512 hash 128-byte blocks; the padding buffer must hold two. */
+#define SAGIT_SHA_MAX_BLOCK     128
+#define SAGIT_SHA_MAX_BLOCK2    (2 * SAGIT_SHA_MAX_BLOCK)
+
+static inline uint32_t
+sagit_rotl32(uint32_t v, unsigned n)
+{
+    return (v << n) | (v >> (32 - n));
+}
+
+static inline uint32_t
+sagit_rotr32(uint32_t v, unsigned n)
+{
+    return (v >> n) | (v << (32 - n));
+}
+
+static inline uint64_t
+sagit_rotr64(uint64_t v, unsigned n)
+{
+    return (v >> n) | (v << (64 - n));
+}
+
+static inline uint32_t
+sagit_be32(const uint8_t *p)
+{
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+        ((uint32_t)p[2] << 8) | (uint32_t)p[3];
+}
+
+/* ------------------------------------------------------------------ SHA-1 */
+
+static void
+sagit_sha1_compress(ccdigest_state_t state, size_t nblocks, const void *data)
+{
+    uint32_t *st = ccdigest_u32(state);
+    const uint8_t *p = (const uint8_t *)data;
+
+    for (; nblocks; nblocks--, p += 64) {
+        uint32_t w[80], a, b, c, d, e;
+        int i;
+
+        for (i = 0; i < 16; i++) {
+            w[i] = sagit_be32(p + 4 * i);
+        }
+        for (i = 16; i < 80; i++) {
+            w[i] = sagit_rotl32(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
+        }
+
+        a = st[0];
+        b = st[1];
+        c = st[2];
+        d = st[3];
+        e = st[4];
+
+        for (i = 0; i < 80; i++) {
+            uint32_t f, k, t;
+
+            if (i < 20) {
+                f = (b & c) | (~b & d);
+                k = 0x5a827999;
+            } else if (i < 40) {
+                f = b ^ c ^ d;
+                k = 0x6ed9eba1;
+            } else if (i < 60) {
+                f = (b & c) | (b & d) | (c & d);
+                k = 0x8f1bbcdc;
+            } else {
+                f = b ^ c ^ d;
+                k = 0xca62c1d6;
+            }
+
+            t = sagit_rotl32(a, 5) + f + e + k + w[i];
+            e = d;
+            d = c;
+            c = sagit_rotl32(b, 30);
+            b = a;
+            a = t;
+        }
+
+        st[0] += a;
+        st[1] += b;
+        st[2] += c;
+        st[3] += d;
+        st[4] += e;
+    }
+}
+
+/* ---------------------------------------------------------------- SHA-256 */
+
+static const uint32_t sagit_sha256_k[64] = {
+    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
+    0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
+    0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
+    0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
+    0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
+    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
+    0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
+    0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
+    0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
+};
+
+static void
+sagit_sha256_compress(ccdigest_state_t state, size_t nblocks, const void *data)
+{
+    uint32_t *st = ccdigest_u32(state);
+    const uint8_t *p = (const uint8_t *)data;
+
+    for (; nblocks; nblocks--, p += 64) {
+        uint32_t w[64], a, b, c, d, e, f, g, h;
+        int i;
+
+        for (i = 0; i < 16; i++) {
+            w[i] = sagit_be32(p + 4 * i);
+        }
+        for (i = 16; i < 64; i++) {
+            uint32_t s0 = sagit_rotr32(w[i - 15], 7) ^
+                sagit_rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
+            uint32_t s1 = sagit_rotr32(w[i - 2], 17) ^
+                sagit_rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
+
+            w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+        }
+
+        a = st[0];
+        b = st[1];
+        c = st[2];
+        d = st[3];
+        e = st[4];
+        f = st[5];
+        g = st[6];
+        h = st[7];
+
+        for (i = 0; i < 64; i++) {
+            uint32_t s1 = sagit_rotr32(e, 6) ^ sagit_rotr32(e, 11) ^
+                sagit_rotr32(e, 25);
+            uint32_t ch = (e & f) ^ (~e & g);
+            uint32_t t1 = h + s1 + ch + sagit_sha256_k[i] + w[i];
+            uint32_t s0 = sagit_rotr32(a, 2) ^ sagit_rotr32(a, 13) ^
+                sagit_rotr32(a, 22);
+            uint32_t maj = (a & b) ^ (a & c) ^ (b & c);
+            uint32_t t2 = s0 + maj;
+
+            h = g;
+            g = f;
+            f = e;
+            e = d + t1;
+            d = c;
+            c = b;
+            b = a;
+            a = t1 + t2;
+        }
+
+        st[0] += a;
+        st[1] += b;
+        st[2] += c;
+        st[3] += d;
+        st[4] += e;
+        st[5] += f;
+        st[6] += g;
+        st[7] += h;
+    }
+}
+
+/* --------------------------------------------------------- SHA-384/SHA-512 */
+
