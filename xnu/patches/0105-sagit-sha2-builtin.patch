+}
+
+/* --------------------------------------------------------------- padding */
+
+/*
+ * FIPS 180-4: 0x80, zeros, then the message length in bits as a big-endian
+ * integer. SHA-1/SHA-256 use 8 length bytes; SHA-384/SHA-512 use 16, and the
+ * length field there is 128 bits wide. The 64-bit bit count is written into
+ * the low half, which is all this kernel can ever produce.
+ */
+static void
+sagit_final_be(const struct ccdigest_info *di, ccdigest_ctx_t ctx,
+    unsigned char *digest, size_t lenbytes, size_t wordsize)
+{
+    uint32_t have = ccdigest_num(di, ctx);
+    uint64_t nbits = ccdigest_nbits(di, ctx);
+    uint8_t *buf = (uint8_t *)ccdigest_data(di, ctx);
+    uint8_t tail[SAGIT_SHA_MAX_BLOCK2];
+    size_t taillen, i;
+
+    memcpy(tail, buf, have);
+    tail[have++] = 0x80;
+    taillen = ((size_t)have + lenbytes <= di->block_size) ?
+        di->block_size : 2 * di->block_size;
+    memset(tail + have, 0, taillen - have);
+    for (i = 0; i < 8; i++) {
+        tail[taillen - 1 - i] = (uint8_t)(nbits >> (8 * i));
+    }
+
+    di->compress(ccdigest_state(di, ctx), taillen / di->block_size, tail);
+
+    if (wordsize == 4) {
+        const uint32_t *st = ccdigest_u32(ccdigest_state(di, ctx));
+
+        for (i = 0; i < di->output_size / 4; i++) {
+            digest[4 * i + 0] = (uint8_t)(st[i] >> 24);
+            digest[4 * i + 1] = (uint8_t)(st[i] >> 16);
+            digest[4 * i + 2] = (uint8_t)(st[i] >> 8);
+            digest[4 * i + 3] = (uint8_t)st[i];
+        }
+    } else {
+        const uint64_t *st = ccdigest_u64(ccdigest_state(di, ctx));
+
+        for (i = 0; i < di->output_size / 8; i++) {
+            digest[8 * i + 0] = (uint8_t)(st[i] >> 56);
+            digest[8 * i + 1] = (uint8_t)(st[i] >> 48);
+            digest[8 * i + 2] = (uint8_t)(st[i] >> 40);
+            digest[8 * i + 3] = (uint8_t)(st[i] >> 32);
+            digest[8 * i + 4] = (uint8_t)(st[i] >> 24);
+            digest[8 * i + 5] = (uint8_t)(st[i] >> 16);
+            digest[8 * i + 6] = (uint8_t)(st[i] >> 8);
+            digest[8 * i + 7] = (uint8_t)st[i];
+        }
+    }
+}
+
+static void
+sagit_sha1_final(const struct ccdigest_info *di, ccdigest_ctx_t ctx,
+    unsigned char *digest)
+{
+    sagit_final_be(di, ctx, digest, 8, 4);
+}
+
+static void
+sagit_sha256_final(const struct ccdigest_info *di, ccdigest_ctx_t ctx,
+    unsigned char *digest)
+{
+    sagit_final_be(di, ctx, digest, 8, 4);
+}
+
+static void
+sagit_sha512_final(const struct ccdigest_info *di, ccdigest_ctx_t ctx,
+    unsigned char *digest)
+{
+    sagit_final_be(di, ctx, digest, 16, 8);
+}
