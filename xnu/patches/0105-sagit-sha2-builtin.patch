+
+static void
+sagit_sha512_compress(ccdigest_state_t state, size_t nblocks, const void *data)
+{
+    uint64_t *st = ccdigest_u64(state);
+    const uint8_t *p = (const uint8_t *)data;
+
+    for (; nblocks; nblocks--, p += 128) {
+        uint64_t w[80], a, b, c, d, e, f, g, h;
+        int i;
+
+        for (i = 0; i < 16; i++) {
+            w[i] = ((uint64_t)sagit_be32(p + 8 * i) << 32) |
+                sagit_be32(p + 8 * i + 4);
+        }
+        for (i = 16; i < 80; i++) {
+            uint64_t s0 = sagit_rotr64(w[i - 15], 1) ^
+                sagit_rotr64(w[i - 15], 8) ^ (w[i - 15] >> 7);
+            uint64_t s1 = sagit_rotr64(w[i - 2], 19) ^
+                sagit_rotr64(w[i - 2], 61) ^ (w[i - 2] >> 6);
+
+            w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+        }
+
+        a = st[0];
+        b = st[1];
+        c = st[2];
+        d = st[3];
+        e = st[4];
+        f = st[5];
+        g = st[6];
+        h = st[7];
+
+        for (i = 0; i < 80; i++) {
+            uint64_t s1 = sagit_rotr64(e, 14) ^ sagit_rotr64(e, 18) ^
+                sagit_rotr64(e, 41);
+            uint64_t ch = (e & f) ^ (~e & g);
+            uint64_t t1 = h + s1 + ch + sagit_sha512_k[i] + w[i];
+            uint64_t s0 = sagit_rotr64(a, 28) ^ sagit_rotr64(a, 34) ^
+                sagit_rotr64(a, 39);
+            uint64_t maj = (a & b) ^ (a & c) ^ (b & c);
+            uint64_t t2 = s0 + maj;
+
+            h = g;
+            g = f;
+            f = e;
+            e = d + t1;
+            d = c;
+            c = b;
+            b = a;
+            a = t1 + t2;
+        }
+
+        st[0] += a;
+        st[1] += b;
+        st[2] += c;
+        st[3] += d;
+        st[4] += e;
+        st[5] += f;
+        st[6] += g;
+        st[7] += h;
