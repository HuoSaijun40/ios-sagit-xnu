diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index a25f581..dae9e40 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1217,6 +1217,10 @@ bsd_init(void)
 	}
 #endif /* DEVFS */
 
+#if defined(SAGIT)
+	printf("SAGIT BI 4a: post-devfs, basesystem block next\n");
+#endif
+
 #if CONFIG_BASESYSTEMROOT
 #if CONFIG_IMAGEBOOT
 	if (bsdmgroot_bootable()) {
@@ -1253,15 +1257,28 @@ bsd_init(void)
 #error CONFIG_BASESYSTEMROOT requires CONFIG_IMAGEBOOT
 #endif /* CONFIG_IMAGEBOOT */
 #endif /* CONFIG_BASESYSTEMROOT */
+#if defined(SAGIT)
+	printf("SAGIT BI 4b: basesystem block done\n");
+#endif
 
 	/* Initialize signal state for process 0. */
 	bsd_init_kprintf("calling siginit\n");
 	siginit(kernproc);
+#if defined(SAGIT)
+	printf("SAGIT BI 4c: siginit done\n");
+#endif
 
