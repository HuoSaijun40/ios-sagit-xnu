 	bsd_utaskbootstrap();
+#if defined(SAGIT)
+	printf("SAGIT BI 4d: bsd_utaskbootstrap done, initproc=%p\n",
+	    (void *)initproc);
+#endif
 
 	pal_kernel_announce();
+#if defined(SAGIT)
+	printf("SAGIT BI 4e: pal_kernel_announce done\n");
+#endif
 
 	bsd_init_kprintf("calling mountroot_post_hook\n");
 
@@ -1283,6 +1300,9 @@ bsd_init(void)
 	 */
 	machine_timeout_bsd_init();
 #endif /* DEVELOPMENT || DEBUG */
+#if defined(SAGIT)
+	printf("SAGIT BI 4f: machine_timeout_bsd_init done\n");
+#endif
 
 #if defined(SAGIT)
 	printf("SAGIT BI 5/8: bsd_init returning\n");
