+#if defined(SAGIT)
+/* Stage probe: panic at step N so the stall point is visible. 0 = off. */
+#ifndef SAGIT_UFS_STAGE
+#define SAGIT_UFS_STAGE 1
+#endif
+#define SAGIT_UFS_STEP(n, what) do { \
+	if (SAGIT_UFS_STAGE != 0 && (n) == SAGIT_UFS_STAGE) { \
+		panic("SAGIT UFS step %d: %s", (n), what); \
+	} \
+} while (0)
+#else
+#define SAGIT_UFS_STEP(n, what) do { } while (0)
+#endif
