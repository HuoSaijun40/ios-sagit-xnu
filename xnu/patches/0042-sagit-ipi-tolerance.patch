diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -117,7 +117,17 @@
 	signalCPU(this);
 	while (!ml_cpu_signal_is_enabled()) {
 		if (mach_absolute_time() > deadline) {
-			panic("SAGIT CPU: SGI1 self-test timed out");
+#if defined(SAGIT)
+			/*
+			 * The port's Group-1 SGI path is not verified yet.  Single-CPU
+			 * bring-up works without IPIs (cross-calls already fail fast while
+			 * SIGPdisabled is set), so log and keep booting instead of stalling.
+			 */
+			IOLog("SAGIT CPU: SGI1 self-test timed out, continuing without IPIs\n");
+			break;
+#else
+			panic("SWEET CPU: SGI1 self-test timed out");
+#endif /* SAGIT */
 		}
 		__asm__ volatile("yield");
 	}
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1872,6 +1872,11 @@
 		INTERRUPT_MASKED_DEBUG_END();
 		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
 	} else if (intid < 16) {
+		static unsigned int sagit_ipi_logged;
+		if (sagit_ipi_logged < 4) {
+			sagit_ipi_logged++;
+			printf("SAGIT: IPI intid %u dispatched\n", intid);
+		}
 		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_IPI);
 		/* Ack before handling so an IPI raised meanwhile is not lost */
 		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
