 #if defined(SAGIT)
-/* Stage probe: panic at step N so the stall point is visible. 0 = off. */
-#ifndef SAGIT_UFS_STAGE
-#define SAGIT_UFS_STAGE 1
-#endif
+/*
+ * Stage trace. Earlier rounds panicked at step N so the stall point was
+ * visible, but that stopped the driver before it did anything and kept the
+ * 0069 spin budget from ever running. Now every step sets a sticky bit and
+ * execution continues; the bits ride along in the panic string when the SCSI
+ * poll gives up, so one boot reports the whole path.
+ */
+static uint32_t sagit_ufs_trace;
 #define SAGIT_UFS_STEP(n, what) do { \
-	if (SAGIT_UFS_STAGE != 0 && (n) == SAGIT_UFS_STAGE) { \
-		panic("SAGIT UFS step %d: %s", (n), what); \
-	} \
+	(void)(what); \
+	sagit_ufs_trace |= (1u << (n)); \
 } while (0)
+#define SAGIT_UFS_TRACE()       (sagit_ufs_trace)
 #else
 #define SAGIT_UFS_STEP(n, what) do { } while (0)
+#define SAGIT_UFS_TRACE()       0
 #endif
 
