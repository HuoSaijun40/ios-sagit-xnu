diff --git a/bsd/pthread/pthread_shims.c b/bsd/pthread/pthread_shims.c
--- a/bsd/pthread/pthread_shims.c
+++ b/bsd/pthread/pthread_shims.c
@@ -315,7 +315,17 @@
 pthread_init(void)
 {
 	if (!pthread_functions) {
+#if defined(SAGIT)
+		/*
+		 * No libpthread kext on this port yet.  Panicking here also blocks the
+		 * UFS root probe in vfs_mountroot(), so warn and carry on until the
+		 * open-source libpthread is built in.
+		 */
+		printf("SAGIT: no pthread function table, continuing without libpthread\n");
+		return;
+#else
 		panic("pthread kernel extension not loaded (function table is NULL).");
+#endif
 	}
 	pthread_functions->pthread_init();
 }
