diff --git a/bsd/dev/sagit_ufs.c b/bsd/dev/sagit_ufs.c
index 4b8fa35..4d46166 100644
--- a/bsd/dev/sagit_ufs.c
+++ b/bsd/dev/sagit_ufs.c
@@ -153,7 +153,7 @@ dma_sync(uint32_t off, uint32_t len)
  * Read direction only. Returns 0 or an errno.
  */
 static int
-ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len)
+ufs_scsi_dir(const uint8_t *cdb, unsigned cdb_len, uint32_t len, int wr)
 {
 	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
 	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
@@ -164,7 +164,12 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len)
 	bzero(ucd, sizeof(*ucd));
 
 	ucd->cmd[0] = 0x01;                     /* COMMAND UPIU */
-	ucd->cmd[1] = len ? 0x40 : 0x00;        /* R: data in */
+	/*
+	 * 0x40 = Data-In (UPIU_CMD_FLAGS_READ), 0x20 = Data-Out
+	 * (UPIU_CMD_FLAGS_WRITE); direction lives in byte 1 of the
+	 * command UPIU.
+	 */
+	ucd->cmd[1] = len ? (wr ? 0x20 : 0x40) : 0x00;
 	ucd->cmd[2] = su.lun;
 	ucd->cmd[3] = ++su.tag;
 	ucd->cmd[12] = (uint8_t)(len >> 24);
@@ -173,7 +178,12 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len)
 	ucd->cmd[15] = (uint8_t)len;
 	memcpy(&ucd->cmd[16], cdb, cdb_len);
 
-	utrd->dw0 = (1u << 28) | ((len ? 2u : 0u) << 25) | (1u << 24);
+	/*
+	 * dword0 bits 25-26 select the data direction:
+	 * 1 = UTP_HOST_TO_DEVICE (write), 2 = UTP_DEVICE_TO_HOST.
+	 */
+	utrd->dw0 = (1u << 28) | ((len ? (wr ? 1u : 2u) : 0u) << 25) |
+	    (1u << 24);
 	utrd->dw2 = 0x0f;                       /* OCS invalid until updated */
 	utrd->ucdba = (uint32_t)ucd_pa;
 	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
@@ -249,6 +259,13 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len)
 	return 0;
 }
 
+/* Every pre-existing call site reads; keep the old name working. */
+static int
+ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len)
+{
+	return ufs_scsi_dir(cdb, cdb_len, len, 0);
+}
+
 /* READ(10) of count device blocks at lba into the bounce buffer. */
 static int
 ufs_read_blocks(uint64_t lba, uint32_t count)
@@ -264,6 +281,25 @@ ufs_read_blocks(uint64_t lba, uint32_t count)
 	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK);
 }
 
+/*
+ * WRITE(10), the mirror of READ(10). The caller fills the bounce buffer and
+ * ufs_scsi_dir flushes it to DRAM before the DMA engine sees it.
+ */
+static int
+ufs_write_blocks(uint64_t lba, uint32_t count)
+{
+	if (lba > UINT32_MAX || count > BOUNCE_SIZE / UFS_BLOCK) {
+		return EINVAL;
+	}
+	uint8_t cdb[10] = {
+		0x2a, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16),
+		(uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi_dir(cdb, sizeof(cdb), count * UFS_BLOCK, 1);
+}
+
 static int
 ufs_find_partition(const char *want)
 {
@@ -377,7 +413,49 @@ sagit_ufs_strategy(buf_t bp)
 
 	buf_setresid(bp, count);
 	if (!(buf_flags(bp) & B_READ)) {
-		error = EROFS;
+		/*
+		 * Write path: read-modify-write. The bounce buffer moves whole
+		 * UFS_BLOCK units, while the caller may ask for any byte range,
+		 * so the untouched head/tail has to be preserved.
+		 */
+		if (off > part_bytes || count > part_bytes - off) {
+			error = EINVAL;
+			goto done;
+		}
+		if (count == 0) {
+			goto done;
+		}
+		if (buf_map(bp, &vaddr)) {
+			error = EIO;
+			goto done;
+		}
+		for (uint32_t wdone = 0; wdone < count;) {
+			uint64_t pos = off + wdone;
+			uint64_t wlba = pos / UFS_BLOCK;
+			uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
+			uint32_t want = MIN(count - wdone,
+			    BOUNCE_SIZE - skip);
+			uint32_t blocks =
+			    (skip + want + UFS_BLOCK - 1) / UFS_BLOCK;
+
+			if (skip != 0 || want != blocks * UFS_BLOCK) {
+				error = ufs_read_blocks(
+				    su.first_block + wlba, blocks);
+				if (error) {
+					break;
+				}
+			}
+			memcpy((void *)(su.dma + DMA_BOUNCE + skip),
+			    vaddr + wdone, want);
+			error = ufs_write_blocks(su.first_block + wlba,
+			    blocks);
+			if (error) {
+				break;
+			}
+			wdone += want;
+			buf_setresid(bp, count - wdone);
+		}
+		buf_unmap(bp);
 		goto done;
 	}
 	if (off > part_bytes || count > part_bytes - off) {
@@ -601,7 +679,7 @@ sagit_ufs_init(void)
 	devfs_make_node(su.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "ufsroot0");
 	devfs_make_node(makedev(su.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rufsroot0");
 	su.ready = true;
-	printf("SAGIT UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, read-only\n",
+	printf("SAGIT UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, read-write\n",
 	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20);
 	return 0;
 }
