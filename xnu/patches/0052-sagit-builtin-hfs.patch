diff --git a/bsd/sagit_hfs/sagit_hfs_compat.h b/bsd/sagit_hfs/sagit_hfs_compat.h
new file mode 100644
--- /dev/null
+++ b/bsd/sagit_hfs/sagit_hfs_compat.h
@@ -0,0 +1,26 @@
+/*
+ * Compile Apple's HFS kext sources inside SAGIT the way the kext is built:
+ * with the kext (KPI) view of the kernel headers, and with only HFS's own
+ * kext-config.h deciding features. The kernel's -DCONFIG_* options are not
+ * visible to a kext build, so the ones HFS tests are cleared first. SAGIT
+ * has no AppleKeyStore, so content protection stays off.
+ */
+#ifndef SAGIT_HFS_COMPAT_H
+#define SAGIT_HFS_COMPAT_H
+#undef BSD_KERNEL_PRIVATE
+#undef XNU_KERNEL_PRIVATE
+#undef CONFIG_PROTECT
+#undef CONFIG_SEARCHFS
+#undef CONFIG_HFS_DIRLINK
+#undef CONFIG_SECLUDED_RENAME
+#undef CONFIG_MACF
+#undef CONFIG_HFS_RBTREE
+#undef QUOTA
+#undef NAMEDSTREAMS
+#undef FIFO
+#undef HFS_COMPRESSION
+#include "core/kext-config.h"
+
+/* Built in, not a loadable kext (see sagit_hfs_iokit.c). */
+#define OSKextGetCurrentLoadTag sagit_hfs_current_load_tag
+#endif
