 int mockfs_init(__unused struct vfsconf * vfsc);
 
+static int
+mockfs_check_macho(vnode_t rvp)
+{
+	buf_t bp = NULL;
+	uint32_t magic = 0;
+	int error;
+
+	error = (int)buf_meta_bread(rvp, 0, DEV_BSIZE, NOCRED, &bp);
+	if (!error) {
+		memcpy(&magic, (const void *)buf_dataptr(bp), sizeof(magic));
+		switch (magic) {
+		case MH_MAGIC:
+		case MH_CIGAM:
+		case MH_MAGIC_64:
+		case MH_CIGAM_64:
+		case FAT_MAGIC:
+		case FAT_CIGAM:
+			break;
+		default:
+			error = EINVAL;
+			break;
+		}
+	}
+	if (bp) {
+		/* Do not leave a DEV_BSIZE block cached for the next filesystem's reads. */
+		buf_markinvalid(bp);
+		buf_brelse(bp);
+	}
+	return error;
+}
