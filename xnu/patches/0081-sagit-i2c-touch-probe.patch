diff --git a/bsd/dev/sagit_i2c.c b/bsd/dev/sagit_i2c.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sagit_i2c.c
--- /dev/null
+++ b/bsd/dev/sagit_i2c.c
@@ -0,0 +1,1687 @@
+/*
+ * SAGIT: minimal BLSP I2C probe for the Synaptics touch controller.
+ *
+ * Goal of this first cut is diagnosis, not input: bring up BLSP1 QUP5 I2C
+ * (i2c@c179000), read whatever the touch chip answers on address 0x20, and
+ * panic with the register state. If the read works, the whole chain (GCC
+ * clocks, TLMM pin mux, touch power) is proven; if it does not, the panic
+ * text says which stage broke.
+ *
+ * Hardware facts (from live.dtb and drivers/clk/qcom/gcc-msm8998.c):
+ *
+ *   I2C controller   /soc/i2c@c179000   reg 0xc179000, 0x600 (BLSP1 QUP5)
+ *   touch            synaptics_dsi_i2c@20, I2C address 0x20
+ *   chips            S3330 (JDI), S3331 (JDI), TD4322 (LGD) depending on panel
+ *   reset gpio       TLMM 89   (pinctrl@0x3400000)
+ *   irq gpio         TLMM 125, SPI 125
+ *
+ *   GCC clocks (gcc-msm8998.c):
+ *     blsp1_qup5_i2c_apps_clk_src  RCG   cmd_rcgr  = 0x21020
+ *     gcc_blsp1_qup5_i2c_apps_clk  CBCR  enable   = 0x21008, BIT(0)
+ *     gcc_blsp1_ahb_clk            CBCR  enable   = 0x52004, BIT(17)
+ *     GCC_BLSP1_QUP5_BCR           reset          = 0x21000
+ *
+ * Ordering matters: report the state of every register BEFORE writing it, so a
+ * single boot tells us what the bootloader already set up. On this SoC ABL
+ * leaves most peripherals running, and the earlier UFS work showed that
+ * assuming otherwise costs whole CI rounds.
+ *
+ * Everything here is polled and bounded: no interrupts, no clocks framework,
+ * no delayed calls, because those are exactly the subsystems that are not
+ * ready this early (the UFS driver hit the same wall).
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+
+#include "sagit_pmic.h"
+#include "sagit_smem.h"
+#include "sagit_glink.h"
+
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer (same as UFS). */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#if defined(SAGIT)
+
+#define SAGIT_I2C_BASE          0xc179000ULL     /* BLSP1 QUP5 */
+#define SAGIT_I2C_SIZE          0x600
+#define SAGIT_TOUCH_ADDR        0x20
+#define SAGIT_TOUCH_UB_ADDR     0x2c             /* bootloader/update mode */
+
+/* GCC */
+/*
+ * GCC base/size from this phone's ADT (/soc/qcom,gcc@100000). Used only as
+ * a fallback when the kernel-visible device tree does not carry the soc
+ * nodes, which v48 proved it does not (both lookup flavours failed).
+ */
+#define SAGIT_GCC_BASE_ADT      0x100000ULL
+#define SAGIT_GCC_SIZE_ADT      0xb0000ULL
+
+/*
+ * The GCC base is NOT a constant in this file any more. Through v46 it
+ * was 0xc000000, guessed from the mainline driver; this phone's ADT says
+ * <0x100000 0xb0000>, i.e. 0xb00000 away. Reading the wrong address hung
+ * the board at stage 8 and every clock register written before that was
+ * equally bogus. The base is now taken from /soc/qcom,gcc at probe time.
+ */
+
+#define SAGIT_QUP5_RCGR         0x21020          /* blsp1_qup5_i2c_apps_clk_src */
+#define SAGIT_QUP5_CBCR         0x21008          /* gcc_blsp1_qup5_i2c_apps_clk */
+#define SAGIT_QUP5_BCR          0x21000          /* reset */
+#define SAGIT_BLSP1_AHB_CBCR    0x52004          /* gcc_blsp1_ahb_clk, BIT(17) */
+#define SAGIT_BLSP1_AHB_HALT    0x17004          /* halt status, BIT(0) */
+#define SAGIT_AHB_ENABLE_BIT    17
+
+/* clk-rcg2 field layout, relative to cmd_rcgr */
+#define RCG_CMD_REG             0x00
+#define RCG_CFG_REG             0x04
+#define RCG_N_REG               0x0c
+#define RCG_D_REG               0x10
+/*
+ * cmd_rcgr bits, from clk-rcg2.c (the only authoritative source):
+ *   CMD_UPDATE   BIT(0)    write 1 to latch the new cfg/n/d
+ *   CMD_ROOT_EN  BIT(1)    root enable -- NOT bit 0
+ *   CMD_ROOT_OFF BIT(31)   1 = root is OFF; 0 = running. There is no
+ *                          separate "running" bit, so the check is inverted.
+ *
+ * Through v51 this file had RCG_ROOT_EN = BIT(0) (that is CMD_UPDATE, so
+ * the write did not set the enable at all) and tested BIT(13) for the root
+ * status (no such bit), so the clock could never be seen as running. v51
+ * still made progress -- rcgr went 0x0 -> 0x2, i.e. the hardware set ROOT_EN
+ * itself -- but the status read-back was against the wrong bit.
+ */
+#define RCG_CMD_UPDATE          (1u << 0)
+#define RCG_ROOT_EN             (1u << 1)
+#define RCG_ROOT_OFF            (1u << 31)
+#define RCG_UPDATE_SEL          0x3u
+#define RCG_UPDATE_SHIFT        12
+
+/*
+ * cmd_rcgr layout (clk-rcg.h / clk-rcg2.c):
+ *   bits 0..2   UP_ROOT_EN  (0x3 = update, 0x2 = root_en)
+ *   bits 8..12  UP_GHID     (same 5-bit update code as hid_width = 5 here)
+ *   bit  13     root status (read only)
+ *
+ * clk-rcg2 programs the new source with both update codes set and then
+ * raises the root enable in a second write that keeps them set; the GHID
+ * half is what tells the hardware a root change is in progress. v50 wrote
+ * only the bits 12..13 field and reused a stale snapshot of cmd (which was
+ * 0), so rcgr read back 0 and the root never started.
+ */
+#define RCG_UP_ROOT_EN_SHIFT    0
+#define RCG_UP_GHID_SHIFT       8
+#define RCG_HID_WIDTH           5
+#define RCG_UP_ROOT_EN_MASK     (0x7u << RCG_UP_ROOT_EN_SHIFT)
+#define RCG_UP_GHID_MASK        ((1u << RCG_HID_WIDTH) - 1u)
+/* GHID update code only (bits 8..12); CMD_UPDATE is added separately. */
+#define RCG_GHID_UPDATE         0x3u
+#define RCG_UPDATE_LATCH        ((0x3u << RCG_UP_ROOT_EN_SHIFT) | \
+	                         (RCG_GHID_UPDATE << RCG_UP_GHID_SHIFT))
+#define RCG_UPDATE_MASK         (RCG_UP_ROOT_EN_MASK | \
+	                         (RCG_UP_GHID_MASK << RCG_UP_GHID_SHIFT))
+#define RCG_SRC_SEL_MASK        (0x7u << 8)
+#define RCG_SRC_SEL_SHIFT       8
+#define RCG_SRC_XO              0                /* 19.2 MHz crystal, no PLL */
+
+/*
+ * QUP v2.2.1 register offsets and field positions.
+ *
+ * Taken verbatim from drivers/i2c/busses/i2c-qup.c, which is the only
+ * authoritative description of this block. An earlier revision of this file
+ * used the v1.1.1 offsets (IO_MODES 0x00c, FIFOs at 0x070/0x078, state PAUSE
+ * 4) -- those do not exist on v2.2.1 and would have produced nothing but
+ * timeouts.
+ */
+#define QUP_CONFIG              0x000
+#define QUP_STATE               0x004
+#define QUP_IO_MODE             0x008
+#define QUP_SW_RESET            0x00c
+#define QUP_OPERATIONAL         0x018
+#define QUP_ERROR_FLAGS         0x01c
+#define QUP_ERROR_FLAGS_EN      0x020
+#define QUP_OPERATIONAL_MASK    0x028
+#define QUP_HW_VERSION          0x030
+#define QUP_MX_OUTPUT_CNT       0x100
+#define QUP_OUT_FIFO_BASE       0x110
+#define QUP_MX_WRITE_CNT        0x150
+#define QUP_MX_INPUT_CNT        0x200
+#define QUP_MX_READ_CNT         0x208
+#define QUP_IN_FIFO_BASE        0x218
+#define QUP_I2C_CLK_CTL         0x400          /* SCL divider: hs_div<<8 | fs_div */
+/*
+ * 400 kHz on a 19.2 MHz source (XO straight through, no PLL):
+ *     hs_div = 3
+ *     fs_div = ((19200000 / 400000) / 2) - 3 = (48 / 2) - 3 = 21
+ *     clk_ctl = (3 << 8) | 21 = 0x315
+ */
+#define SAGIT_QUP_CLK_CTL_400K  0x315u
+#define QUP_I2C_STATUS          0x404
+#define QUP_I2C_MASTER_GEN      0x408
+
+/* QUP states (i2c-qup.c: QUP_RESET/RUN/PAUSE_STATE) */
+#define QUP_STATE_RESET         0
+#define QUP_STATE_RUN           1
+#define QUP_STATE_PAUSE         3
+#define QUP_STATE_MASK          3
+#define QUP_STATE_VALID         (1u << 2)
+
+/* QUP_OPERATIONAL flags */
+#define QUP_OP_IN_NOT_EMPTY     (1u << 5)
+#define QUP_OP_OUT_SVC_FLAG     (1u << 8)
+#define QUP_OP_IN_SVC_FLAG      (1u << 9)
+#define QUP_OP_MAX_OUTPUT_DONE  (1u << 10)
+#define QUP_OP_MAX_INPUT_DONE   (1u << 11)
+#define QUP_OPERATIONAL_RESET   0x000ff0u
+
+/* QUP_IO_MODE packing */
+#define QUP_IO_OUTPUT_BLK_MODE  (1u << 10)
+#define QUP_IO_INPUT_BLK_MODE   (1u << 12)
+#define QUP_IO_UNPACK_EN        (1u << 14)
+#define QUP_IO_PACK_EN          (1u << 15)
+/*
+ * i2c-qup.c always starts from QUP_REPACK_EN and ORs the block-mode bits in:
+ *     u32 io_mode = QUP_REPACK_EN;   -- = UNPACK_EN | PACK_EN
+ * Without it the FIFO does not pack/unpack 32-bit words the way the tag
+ * protocol expects.
+ */
+#define QUP_REPACK_EN           (QUP_IO_UNPACK_EN | QUP_IO_PACK_EN)
+
+/*
+ * i2c-qup.c: config_run = is_first ? 0 : QUP_I2C_MX_CONFIG_DURING_RUN.
+ * The counts of the second and later sub-transfers carry this bit.
+ */
+#define QUP_I2C_MX_CONFIG_DURING_RUN   (1u << 31)
+
+/* I2C mini core: QUP_CONFIG layout */
+#define QUP_CLOCK_AUTO_GATE     (1u << 13)
+#define QUP_NO_INPUT            (1u << 7)
+#define QUP_I2C_MINI_CORE       (2u << 8)
+#define QUP_I2C_N_VAL           15
+#define QUP_I2C_MAST_GEN        (1u << 4)          /* QUP_STATE bit: master */
+#define QUP_I2C_MASTER_GEN_REG  0x408          /* master-gen config reg */
+#define QUP_V2_TAGS_EN          1              /* must be written to it */
+#define QUP_I2C_N_VAL_V2        7              /* low 3 bits of QUP_CONFIG */
+
+/* QUP v2 tag bytes: these are what actually start a transfer. */
+#define QUP_TAG_V2_START        0x81
+#define QUP_TAG_V2_DATAWR       0x82
+#define QUP_TAG_V2_DATAWR_STOP  0x83
+#define QUP_TAG_V2_DATARD       0x85
+#define QUP_TAG_V2_DATARD_NACK  0x86
+#define QUP_TAG_V2_DATARD_STOP  0x87
+
+/*
+ * Bounded spin: no clock, no timeout subsystem (same rule as the UFS driver).
+ *
+ * 200000 was not "generous", it was dangerous. If the block being polled is
+ * not clocked, every read costs a bus timeout rather than a few nanoseconds,
+ * so 200000 iterations can take minutes -- far past the SoC watchdog, which is
+ * what the v43 freeze looked like: no panic, just a reset. 20000 keeps the
+ * margin (a real transfer needs ~235 us) while guaranteeing that a dead bus
+ * ends in a panic we can read instead of a silent reset.
+ */
+#define SAGIT_I2C_SPIN          20000u
+
+static struct {
+	volatile uint32_t *regs;        /* QUP registers */
+	volatile uint32_t *gcc;         /* GCC registers */
+	uint32_t txn;                   /* rolling diagnostic step */
+	uint32_t clk_ctl_readback;      /* QUP_I2C_CLK_CTL after programming */
+	uint32_t rst_cfg_start;         /* gpio89 ctl before the pulse */
+	uint32_t rst_cfg_low;           /* gpio89 ctl after driving low */
+	uint32_t rst_cfg_after;         /* gpio89 ctl after release */
+	uint32_t rst_driven_high;       /* gpio89 io out_bit after driving high */
+	uint32_t pmic_rc;               /* sagit_pmic_ldo6_on() result */
+	uint32_t pmic_ver;              /* SPMI arbiter version word */
+	uint32_t pmic_apid;             /* resolved APID, 0xffffffff if none */
+	uint32_t pmic_st;               /* STATUS after the ENABLE write */
+	uint32_t pmic_en_rb;            /* ENABLE read back from the PMIC */
+	uint32_t pmic_md_rb;            /* MODE read back from the PMIC */
+	uint32_t pmic_owner;            /* APID ownership word */
+	uint32_t pmic_md_before;        /* MODE before the RMW */
+	uint32_t avdd_io_after;         /* gpio50 io after enabling the rail */
+	uint32_t avdd_cfg_after;        /* gpio50 ctl after enabling the rail */
+	uint32_t avdd_io_before;        /* gpio50 io before enabling the rail */
+	uint32_t avdd_cfg_before;       /* gpio50 ctl before enabling the rail */
+	uint32_t pmic_rg_rb;            /* RANGE read back */
+	uint32_t pmic_sv_rb;            /* VOLTAGE_SET read back */
+	uint32_t pmic_type_rb;          /* LDO TYPE (0x4504): proves SPMI reads work */
+	uint32_t pmic_subtype_rb;       /* LDO SUBTYPE (0x4505) */
+	/* SMEM / RPM feasibility, see sagit_smem.c */
+	uint32_t smem_rc;               /* 0 = mapped and magic matched */
+	uint32_t smem_magic;
+	uint32_t smem_entries;
+	uint32_t smem_rpm_item;
+	uint32_t rpm_ram_rc;
+	uint32_t rpm_toc_magic;         /* RPM msg RAM TOC magic ("grt0" if cached OK) */
+	uint32_t rpm_toc_count;
+	uint32_t rpm_w0, rpm_w1;        /* first words of RPM msg RAM */
+	uint32_t glink_rc;              /* sagit_glink_ldo6_on() result: 0=ok */
+	uint32_t glink_state;           /* handshake milestone bitmask */
+	uint32_t glink_ack;             /* last ack msg_id seen */
+	uint32_t glink_ack_kind;        /* 0=none 1=msg# 2=err */
+	uint32_t glink_ack_err;         /* first 4 bytes of an err string */
+	uint32_t glink_tx_off, glink_tx_sz, glink_tx_h, glink_tx_t;
+	uint32_t glink_rx_off, glink_rx_sz, glink_rx_h, glink_rx_t;
+	uint32_t phys_base;             /* gPhysBase XNU is running with */
+	uint32_t phys_size;             /* real_phys_size of the same */
+	uint32_t stop_at;               /* sagit_tstop=N: panic on entering N */
+} si2c;
+
+/*
+ * Stage gate.
+ *
+ * The board froze between two printf() calls and never reset, so "which line
+ * is last on screen" cannot distinguish "printf never ran" from "we never got
+ * there". Every stage therefore calls this first, and a boot argument turns
+ * any single stage into a panic: with sagit_tstop=N, reaching stage N prints
+ * "reached N" through panic() and stops. The run stops on the LAST stage
+ * before the freeze, so one screenshot names the frozen stage exactly.
+ */
+static void
+si2c_stage(uint32_t n)
+{
+	if (si2c.stop_at == n) {
+		panic("SAGIT I2C STOP reached stage %u (1-8 probe, 12 gcc-node) "
+		    "(the next stage is where it hangs)", n);
+	}
+	si2c.txn = n;
+}
+
+/* Called from bsd_init with the parsed sagit_tstop value (0 = never stop). */
+void
+sagit_i2c_set_stop_at(uint32_t n)
+{
+	si2c.stop_at = n;
+}
+
+static inline uint32_t
+si2c_rdq(uint32_t off)
+{
+	return si2c.regs[off / 4];
+}
+
+static inline void
+si2c_wrq(uint32_t off, uint32_t v)
+{
+	si2c.regs[off / 4] = v;
+}
+
+static inline uint32_t
+si2c_rdg(uint32_t off)
+{
+	return si2c.gcc[off / 4];
+}
+
+static inline void
+si2c_wrg(uint32_t off, uint32_t v)
+{
+	si2c.gcc[off / 4] = v;
+}
+
+/*
+ * Report-and-continue: leave a breadcrumb of the register's previous value in
+ * si2c.txn's high bits so the final panic can show "what it was" without
+ * needing separate panics per stage.
+ */
+static uint32_t
+si2c_enable_branch(uint32_t off, uint32_t bit, uint32_t *before)
+{
+	uint32_t old = si2c_rdg(off);
+
+	*before = old;
+	if (!(old & (1u << bit))) {
+		si2c_wrg(off, old | (1u << bit));
+	}
+	return si2c_rdg(off);
+}
+
+/*
+ * Defined with the pin helpers further down, but the QUP polls need it: a
+ * state transition takes real microseconds (3 AHB + 3 I2C master clock
+ * cycles, ~15 us at 400 kHz), not just another MMIO read.
+ */
+static void si2c_settle(uint32_t ticks);
+
+static void
+si2c_report(const char *what, uint32_t a, uint32_t b, uint32_t c, uint32_t d)
+{
+	panic("SAGIT I2C %s: qcfg=0x%x qstate=0x%x qstatus=0x%x qop=0x%x "
+	    "rcgr=0x%x cfg=0x%x qup5c=0x%x ahb=0x%x ahbhalt=0x%x d=%d/%d",
+	    what, a, b, c, d,
+	    si2c_rdg(SAGIT_QUP5_RCGR), si2c_rdg(SAGIT_QUP5_RCGR + RCG_CFG_REG),
+	    si2c_rdg(SAGIT_QUP5_CBCR), si2c_rdg(SAGIT_BLSP1_AHB_CBCR),
+	    si2c_rdg(SAGIT_BLSP1_AHB_HALT),
+	    (int)si2c.txn, 0);
+}
+
+/*
+ * Clock-stage report, used by the caller after si2c_clock_up() returns an
+ * error. Only GCC registers are read here, never the QUP block: the whole
+ * point of the classification is that the QUP may not be clocked, and a read
+ * of an unclocked block is what takes the bus down.
+ */
+static void
+si2c_clock_report(const char *what, uint32_t extra)
+{
+	panic("SAGIT I2C %s: rcgr=0x%x cfg=0x%x n=0x%x d=0x%x "
+	    "qup5c=0x%x ahb=0x%x ahbhalt=0x%x bcr=0x%x extra=0x%x step=%d",
+	    what,
+	    si2c_rdg(SAGIT_QUP5_RCGR + RCG_CMD_REG),
+	    si2c_rdg(SAGIT_QUP5_RCGR + RCG_CFG_REG),
+	    si2c_rdg(SAGIT_QUP5_RCGR + RCG_N_REG),
+	    si2c_rdg(SAGIT_QUP5_RCGR + RCG_D_REG),
+	    si2c_rdg(SAGIT_QUP5_CBCR),
+	    si2c_rdg(SAGIT_BLSP1_AHB_CBCR),
+	    si2c_rdg(SAGIT_BLSP1_AHB_HALT),
+	    si2c_rdg(SAGIT_QUP5_BCR),
+	    extra, (int)si2c.txn);
+}
+
+/* Poll for a condition, bounded. Returns 1 on success. */
+static int
+si2c_poll(uint32_t off, uint32_t mask, uint32_t want, uint32_t spins)
+{
+	for (uint32_t i = 0; i < spins; i++) {
+		if ((si2c_rdq(off) & mask) == want) {
+			return 1;
+		}
+		/*
+		 * Same reason as the state poll: QUP_SW_RESET self-clears after
+		 * the block finishes resetting, which takes real time.
+		 */
+		si2c_settle(1);
+	}
+	return 0;
+}
+
+/* VALID means the block finished its last transition (i2c-qup.c). */
+static int
+si2c_poll_state_valid(uint32_t spins)
+{
+	for (uint32_t i = 0; i < spins; i++) {
+		if (si2c_rdq(QUP_STATE) & QUP_STATE_VALID) {
+			return 1;
+		}
+		si2c_settle(1);
+	}
+	return 0;
+}
+
+/*
+ * Defined further down with the pin helpers, but the state poll needs it:
+ * a state transition needs real microseconds, not another MMIO read.
+ */
+/*
+ * Poll a state-machine state the way i2c-qup.c does.
+ *
+ * qup_i2c_poll_state_mask() is:
+ *
+ *     if (state & QUP_STATE_VALID && (state & req_mask) == req_state)
+ *
+ * VALID is BIT(2) of QUP_STATE and it is *not* part of QUP_STATE_MASK (3), so
+ * comparing only the low two bits accepts a state register that has not
+ * finished transitioning -- or, if the block is not clocked at all, whatever
+ * garbage the bus returns. That is exactly how v44 got here: every transition
+ * "succeeded" in a few spins, and the very next access to the block, with the
+ * state machine still wedged, is what took the interconnect down and lost the
+ * 8/9 and 9/9 lines.
+ */
+static int
+si2c_poll_state(uint32_t want, uint32_t spins)
+{
+	for (uint32_t i = 0; i < spins; i++) {
+		uint32_t st = si2c_rdq(QUP_STATE);
+
+		if ((st & QUP_STATE_VALID) &&
+		    (st & QUP_STATE_MASK) == want) {
+			return 1;
+		}
+		/*
+		 * The state machine needs real time, not just another read.
+		 *
+		 * i2c-qup.c, qup_i2c_poll_state_mask():
+		 *   "State transition takes 3 AHB clocks cycles + 3 I2C master
+		 *    clock cycles. So retry once after a 1uS delay."
+		 *   ...
+		 *   udelay(1);
+		 *
+		 * At 400 kHz the I2C half alone is ~15 us, so a tight MMIO spin
+		 * burns all its iterations long before the transition can
+		 * finish. v55 did exactly that and reported qstate = 0x1c (VALID
+		 * and MAST_GEN set, but the low two bits still 0 = RESET) every
+		 * time -- the block was fine, the poll gave up too early.
+		 *
+		 * si2c_settle(1) is a bounded spin that costs microseconds, the
+		 * same unit the clock bring-up already uses.
+		 */
+		si2c_settle(1);
+	}
+	return 0;
+}
+
+/*
+ * Bring up the QUP clocks by writing the GCC registers directly.
+ * No clock framework exists yet, so this is the "give it a running clock"
+ * step, and it deliberately leaves a breadcrumb if the root refuses to start.
+ */
+static int
+si2c_clock_up(void)
+{
+	uint32_t before_ahb = 0, before_qup = 0;
+	uint32_t cmd, cfg;
+
+	si2c.txn = 1;
+
+	/* 1. AHB first: the QUP register block needs its bus clock. */
+	si2c_enable_branch(SAGIT_BLSP1_AHB_CBCR, SAGIT_AHB_ENABLE_BIT, &before_ahb);
+
+	/*
+	 * 1b. Bring the RCG block out of reset first. bcr (GCC_..._BCR) read as
+	 * 0x0 in v50, which is the un-asserted state, but the block reset is
+	 * what actually gates writes landing in cmd_rcgr: writing ROOT_EN while
+	 * the block is still held shows up as rcgr reading back 0. Assert and
+	 * release it so the block is definitely live before configuring it.
+	 */
+	si2c_wrg(SAGIT_QUP5_BCR, 0x1);
+	si2c_wrg(SAGIT_QUP5_BCR, 0x0);
+
+	/* 2. RCG: select the XO parent (straight 19.2 MHz, no PLL involved). */
+	cmd = si2c_rdg(SAGIT_QUP5_RCGR + RCG_CMD_REG);
+	cfg = si2c_rdg(SAGIT_QUP5_RCGR + RCG_CFG_REG);
+
+	if ((cfg & RCG_SRC_SEL_MASK) != (RCG_SRC_XO << RCG_SRC_SEL_SHIFT)) {
+		si2c_wrg(SAGIT_QUP5_RCGR + RCG_CFG_REG,
+		    (cfg & ~RCG_SRC_SEL_MASK) | (RCG_SRC_XO << RCG_SRC_SEL_SHIFT));
+	}
+	/* F(19200000, P_XO, 1, 0, 0): divide by 1, so N and D stay 0. */
+	si2c_wrg(SAGIT_QUP5_RCGR + RCG_N_REG, 0);
+	si2c_wrg(SAGIT_QUP5_RCGR + RCG_D_REG, 0);
+
+	/*
+	 * Latch the source/divider change, then set the root enable.
+	 *
+	 * clk-rcg2.c's __clk_rcg2_set_rate() is:
+	 *     regmap_update_bits(regmap, cmd_rcgr + CMD_REG, CMD_UPDATE, CMD_UPDATE);
+	 * and the enable path is simply:
+	 *     regmap_update_bits(regmap, cmd_rcgr + CMD_REG, CMD_ROOT_EN, CMD_ROOT_EN);
+	 *
+	 * The GHID half of the update code (bits 8..12, hid_width = 5 on this
+	 * clock) goes along with CMD_UPDATE so the hardware knows a root change
+	 * is in flight; it is not part of the enable write. Writing CMD_ROOT_EN
+	 * as BIT(0) (what v51 did) set CMD_UPDATE instead and never enabled
+	 * anything -- the root only came up because the latch write happened to
+	 * land first.
+	 */
+	cmd = si2c_rdg(SAGIT_QUP5_RCGR + RCG_CMD_REG);
+	cmd &= ~RCG_UPDATE_MASK;
+
+	/* latch: CMD_UPDATE | GHID update code */
+	si2c_wrg(SAGIT_QUP5_RCGR + RCG_CMD_REG,
+	    cmd | RCG_CMD_UPDATE | (RCG_GHID_UPDATE << RCG_UP_GHID_SHIFT));
+
+	/* enable the root: CMD_ROOT_EN on its own */
+	si2c_wrg(SAGIT_QUP5_RCGR + RCG_CMD_REG, cmd | RCG_ROOT_EN);
+
+	si2c.txn = 2;
+
+	/* 3. Apps clock branch. */
+	si2c_enable_branch(SAGIT_QUP5_CBCR, 0, &before_qup);
+
+	si2c.txn = 3;
+
+	/*
+	 * Do NOT panic in here. Through v44 this function panicked on a clock
+	 * failure, which meant the lines after the call -- 8/9 and 9/9 -- were
+	 * compiled but unreachable on a failure, and the screen showed nothing
+	 * between 7/9 and the end of the probe. Returning a code lets the caller
+	 * print the register state first and then panic on purpose.
+	 */
+	if (si2c_rdg(SAGIT_QUP5_RCGR + RCG_CMD_REG) & RCG_ROOT_OFF) {
+		/* RCG root never started: the parent (XO) or the GDSC is not up. */
+		return EAGAIN;
+	}
+	if (si2c_rdg(SAGIT_BLSP1_AHB_HALT) & 1u) {
+		/* gcc_blsp1_ahb_clk is BRANCH_HALT_VOTED: bit set means halted. */
+		return EBUSY;
+	}
+
+	return 0;
+}
+
+/*
+ * Wait until the block reports itself as an I2C master.
+ *
+ * i2c-qup.c: qup_i2c_poll_state_i2c_master() waits for QUP_STATE to be VALID
+ * with QUP_I2C_MAST_GEN (BIT 4) set. This is what tells us the tag-driven v2
+ * transfer engine is actually armed; without it a write of QUP_V2_TAGS_EN to
+ * QUP_I2C_MASTER_GEN may not have taken effect and every transfer times out.
+ */
+static int
+si2c_poll_state_master(uint32_t spins)
+{
+	for (uint32_t i = 0; i < spins; i++) {
+		uint32_t st = si2c_rdq(QUP_STATE);
+
+		if ((st & QUP_STATE_VALID) && (st & QUP_I2C_MAST_GEN)) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+/*
+ * Change the QUP state exactly like qup_i2c_change_state():
+ *
+ *     if (qup_i2c_poll_state_valid(qup) != 0) return -EIO;   -- VALID set
+ *     writel(state, QUP_STATE);
+ *     if (qup_i2c_poll_state(qup, state) != 0) return -EIO;
+ *
+ * The up-front VALID check is not optional: writing a state while the block
+ * has not finished a previous transition writes into a register the machine
+ * ignores, which is indistinguishable from the transition silently failing.
+ * v55 wrote RUN unconditionally and then polled -- qstate stayed 0x1c
+ * (VALID|MAST_GEN, low bits 0) and the transfer never started.
+ *
+ * Returns 0 on success.
+ */
+static int
+si2c_change_state(uint32_t state)
+{
+	if (!si2c_poll_state_valid(SAGIT_I2C_SPIN)) {
+		return EBUSY;
+	}
+	si2c_wrq(QUP_STATE, state);
+	if (!si2c_poll_state(state, SAGIT_I2C_SPIN)) {
+		return ENXIO;
+	}
+	return 0;
+}
+
+/*
+ * Configure the QUP for a single small read. This mirrors the sequence in
+ * i2c-qup.c: reset -> run -> pause, program the counters, unpause.
+ */
+static int
+si2c_qup_init(void)
+{
+	si2c.txn = 4;
+
+	/* Bring the block back to a known state (i2c-qup.c does the same). */
+	si2c_wrq(QUP_CONFIG, 0);
+	if (si2c_change_state(QUP_STATE_RESET) != 0) {
+		return ENXIO;
+	}
+	si2c.txn = 5;
+
+	si2c_wrq(QUP_SW_RESET, 1);
+	if (!si2c_poll(QUP_SW_RESET, 1u, 0u, SAGIT_I2C_SPIN)) {
+		return EBUSY;
+	}
+	si2c_wrq(QUP_ERROR_FLAGS_EN, 0);
+	si2c_wrq(QUP_OPERATIONAL_MASK, 0);
+	si2c.txn = 6;
+
+	/*
+	 * I2C mini core. This follows i2c-qup.c's v2 bring-up exactly:
+	 *
+	 *     writel(I2C_MINI_CORE | I2C_N_VAL_V2, QUP_CONFIG);
+	 *     writel(QUP_V2_TAGS_EN, QUP_I2C_MASTER_GEN);
+	 *     qup_i2c_poll_state_i2c_master()   (waits for QUP_I2C_MAST_GEN)
+	 *
+	 * Three things were wrong through v52:
+	 *   - N_VAL is the low 3 bits (I2C_N_VAL_V2 = 7 is written as 7, not
+	 *     7 << 16). The old value made qcfg read back 0x32210 instead of
+	 *     0x207.
+	 *   - QUP_I2C_MAST_GEN (BIT 4) is a bit of the SEPARATE
+	 *     QUP_I2C_MASTER_GEN register at 0x408, not of QUP_CONFIG.
+	 *   - QUP_V2_TAGS_EN (1) must be written there, otherwise the block
+	 *     never accepts tag-driven transfers at all.
+	 */
+	si2c_wrq(QUP_CONFIG, QUP_I2C_MINI_CORE | QUP_I2C_N_VAL_V2);
+	si2c_wrq(QUP_I2C_MASTER_GEN_REG, QUP_V2_TAGS_EN);
+	si2c.txn = 7;
+
+	/*
+	 * Wait for the block to report itself as an I2C master, exactly like
+	 * qup_i2c_poll_state_i2c_master(): QUP_STATE must be valid AND have
+	 * QUP_I2C_MAST_GEN set.
+	 */
+	if (!si2c_poll_state_master(SAGIT_I2C_SPIN)) {
+		return ENXIO;
+	}
+	si2c.txn = 8;
+
+	/*
+	 * QUP_IO_MODE: REPACK_EN plus block mode only where the transfer is
+	 * bigger than the FIFO. Ours is 4 tags (+6 bytes on the read), which is
+	 * far below any FIFO, so i2c-qup.c would run this in FIFO mode:
+	 *     is_tx_blk_mode = total_tx_len > out_fifo_sz
+	 *     is_rx_blk_mode = total_rx_len > in_fifo_sz
+	 * v54 forced block mode on both directions, which changes how the tags
+	 * are consumed (block mode wants OUT_BLOCK_WRITE_REQ handshaking that
+	 * this probe does not implement).
+	 */
+	si2c_wrq(QUP_IO_MODE, QUP_REPACK_EN);
+
+	/*
+	 * Zero the count register of the direction not in use, the way
+	 * qup_i2c_conf_mode_v2() does, so a stale count from an earlier
+	 * sub-transfer can never leak in.
+	 */
+	si2c_wrq(QUP_MX_OUTPUT_CNT, 0);
+	si2c_wrq(QUP_MX_WRITE_CNT, 0);
+	si2c_wrq(QUP_MX_INPUT_CNT, 0);
+	si2c_wrq(QUP_MX_READ_CNT, 0);
+	/*
+	 * clk_ctl is written where i2c-qup.c writes it -- inside the first
+	 * transition (RUN -> clk_ctl -> PAUSE). Writing it here, while the block
+	 * is still in RESET, was v56: the value may simply be dropped.
+	 */
+
+	return 0;
+}
+
+/*
+ * Push `nbytes` tag bytes into the output FIFO.
+ *
+ * The QUP v2 FIFO takes 32-bit words, and i2c-qup.c's qup_i2c_write_blk_data()
+ * packs FOUR tag bytes into one word, little endian within the word:
+ *
+ *     blk->tx_fifo_data |= *(*data)++ << (j * 8);
+ *     if (j == 3) { writel(blk->tx_fifo_data, QUP_OUT_FIFO_BASE); ... }
+ *
+ * and flushes the partial last word if it is non-zero:
+ *
+ *     if (blk->tx_fifo_data_pos) writel(blk->tx_fifo_data, ...);
+ *
+ * Through v54 this function wrote one byte per register access. That fills
+ * the FIFO with un-packed bytes, so the block sees garbage tags, the output
+ * FIFO goes full (qop = 0xc0, OUT_FULL) and the transfer never starts.
+ *
+ * Returns 0 on success.
+ */
+static int
+si2c_write_tags(const uint8_t *tags, uint32_t nbytes)
+{
+	uint32_t word = 0;
+	uint32_t j = 0;
+
+	for (uint32_t i = 0; i < nbytes; i++) {
+		word |= (uint32_t)tags[i] << (j * 8);
+		if (j == 3) {
+			si2c_wrq(QUP_OUT_FIFO_BASE, word);
+			word = 0;
+			j = 0;
+		} else {
+			j++;
+		}
+	}
+	if (j != 0) {
+		si2c_wrq(QUP_OUT_FIFO_BASE, word);
+	}
+	return 0;
+}
+
+/*
+ * One I2C register read using the v2 tag protocol.
+ *
+ * A "read register" is two transactions on the wire, and each one is described
+ * by tag bytes pushed into the output FIFO (i2c-qup.c: qup_i2c_set_tags):
+ *
+ *   write phase : 0x81 addr  0x82 reg   0x83        START, DATAWR, DATAWR_STOP
+ *   read phase  : 0x81 addr  0x85 len   0x87        START, DATARD, DATARD_STOP
+ *
+ * The counts then tell the block how many bytes cross the FIFOs.
+ */
+static int
+si2c_read_addr(uint8_t addr, uint16_t reg, uint8_t *out, uint32_t len)
+{
+	uint32_t op;
+	uint32_t spins;
+
+	if (len == 0 || len > 256) {
+		return EINVAL;
+	}
+
+	si2c.txn = 10;
+
+	/*
+	 * Program the bus clock where i2c-qup.c does it: inside the first
+	 * sub-transfer, between RUN and PAUSE.
+	 *
+	 *     if (is_first) {
+	 *         qup_i2c_change_state(qup, QUP_RUN_STATE);
+	 *         writel(qup->clk_ctl, qup->base + QUP_I2C_CLK_CTL);
+	 *         qup_i2c_change_state(qup, QUP_PAUSE_STATE);
+	 *     }
+	 *
+	 * Without a bus clock the QUP cannot leave RESET, which is exactly the
+	 * qstate=0x1c (reset value) seen since v53.
+	 */
+	if (si2c_change_state(QUP_STATE_RUN) != 0) {
+		return ENXIO;
+	}
+	si2c_wrq(QUP_I2C_CLK_CTL, SAGIT_QUP_CLK_CTL_400K);
+	si2c.clk_ctl_readback = si2c_rdq(QUP_I2C_CLK_CTL);
+
+	/* Pause the block so the counters and FIFO can be programmed. */
+	if (si2c_change_state(QUP_STATE_PAUSE) != 0) {
+		return ETIMEDOUT;
+	}
+	si2c.txn = 11;
+
+	/*
+	 * Write phase: START, addr<<1, DATAWR, then the two RMI4 address bytes
+	 * (little endian).
+	 *
+	 * Counts follow i2c-qup.c's qup_i2c_conf_count_v2(): in FIFO mode the
+	 * TX length goes to QUP_MX_WRITE_CNT and the unused OUTPUT_CNT is
+	 * zeroed, the RX side is zeroed, and because total_rx_len == 0 this
+	 * sub-transfer also sets QUP_NO_INPUT in QUP_CONFIG.
+	 */
+	uint8_t wtags[5];
+	uint32_t wlen = 0;
+
+	wtags[wlen++] = QUP_TAG_V2_START;
+	wtags[wlen++] = (uint8_t)(addr << 1);
+	wtags[wlen++] = QUP_TAG_V2_DATAWR;
+	wtags[wlen++] = (uint8_t)(reg & 0xff);
+	wtags[wlen++] = (uint8_t)(reg >> 8);
+
+	/* First sub-transfer: config_run is 0. */
+	si2c_wrq(QUP_MX_OUTPUT_CNT, 0);
+	si2c_wrq(QUP_MX_INPUT_CNT, 0);
+	si2c_wrq(QUP_MX_READ_CNT, 0);
+	si2c_wrq(QUP_MX_WRITE_CNT, wlen);
+	si2c_wrq(QUP_CONFIG,
+	    QUP_I2C_MINI_CORE | QUP_I2C_N_VAL_V2 | QUP_NO_INPUT);
+
+	/* Clear stale operational flags before running. */
+	si2c_wrq(QUP_OPERATIONAL, QUP_OPERATIONAL_RESET);
+
+	if (si2c_write_tags(wtags, wlen) != 0) {
+		return ETIMEDOUT;
+	}
+	if (si2c_change_state(QUP_STATE_RUN) != 0) {
+		return ENXIO;
+	}
+	si2c.txn = 12;
+
+	for (spins = 0; spins < SAGIT_I2C_SPIN; spins++) {
+		op = si2c_rdq(QUP_OPERATIONAL);
+		if (op & QUP_OP_MAX_OUTPUT_DONE) {
+			break;
+		}
+	}
+	if (spins == SAGIT_I2C_SPIN) {
+		return ETIMEDOUT;
+	}
+	si2c.txn = 13;
+
+	/* Read phase: 4 tag bytes out, len bytes in. */
+	if (si2c_change_state(QUP_STATE_PAUSE) != 0) {
+		return ETIMEDOUT;
+	}
+
+	uint8_t rtags[4] = {
+		QUP_TAG_V2_START, (uint8_t)((addr << 1) | 1),
+		QUP_TAG_V2_DATARD_STOP, (uint8_t)(len == 256 ? 0 : len),
+	};
+	/*
+	 * Second sub-transfer: config_run = QUP_I2C_MX_CONFIG_DURING_RUN, the
+	 * TX length is the tag bytes, and this one does read, so NO_INPUT is
+	 * clear. QUP_MX_WRITE_CNT gets the run bit too, since the write phase
+	 * already consumed its count.
+	 */
+	si2c_wrq(QUP_MX_OUTPUT_CNT, 0);
+	si2c_wrq(QUP_MX_WRITE_CNT, 4 | QUP_I2C_MX_CONFIG_DURING_RUN);
+	si2c_wrq(QUP_MX_READ_CNT, 0);
+	si2c_wrq(QUP_MX_INPUT_CNT, len | QUP_I2C_MX_CONFIG_DURING_RUN);
+	si2c_wrq(QUP_CONFIG, QUP_I2C_MINI_CORE | QUP_I2C_N_VAL_V2);
+
+	si2c_wrq(QUP_OPERATIONAL, QUP_OPERATIONAL_RESET);
+	if (si2c_write_tags(rtags, 4) != 0) {
+		return ETIMEDOUT;
+	}
+	if (si2c_change_state(QUP_STATE_RUN) != 0) {
+		return ENXIO;
+	}
+	si2c.txn = 14;
+
+	for (spins = 0; spins < SAGIT_I2C_SPIN; spins++) {
+		op = si2c_rdq(QUP_OPERATIONAL);
+		if (op & QUP_OP_MAX_INPUT_DONE) {
+			break;
+		}
+	}
+	si2c.txn = 15;
+
+	if (spins == SAGIT_I2C_SPIN) {
+		return ETIMEDOUT;
+	}
+
+	/* A NACK shows up here rather than as a timeout. */
+	if (si2c_rdq(QUP_ERROR_FLAGS) || (si2c_rdq(QUP_I2C_STATUS) & 0x38000fc)) {
+		return EIO;
+	}
+
+	for (uint32_t i = 0; i < len; i++) {
+		out[i] = (uint8_t)si2c_rdq(QUP_IN_FIFO_BASE);
+	}
+	si2c.txn = 16;
+
+	return 0;
+}
+
+/*
+ * RMI4 register read: two address bytes, little endian.
+ *
+ * The Synaptics protocol is not plain register I/O -- every transfer carries a
+ * 16-bit address before the data, which is why rmi4_i2c calls it a "0x0000
+ * page descriptor" read at probe time rather than an ID register.
+ */
+static int
+si2c_read_rmi4(uint8_t addr, uint16_t reg, uint8_t *out, uint32_t len)
+{
+	return si2c_read_addr(addr, reg, out, len);
+}
+
+/*
+ * Entry point, called once from bsd_init() before mounting anything.
+ *
+ * Stage reporting is the point: every exit panics with the register state, so a
+ * screenshot always identifies the failing stage without another CI round.
+ */
+/*
+ * Pin state read-out for the touch bus.
+ *
+ * msm8998 has several TLMM tiles and each pin lives at an offset inside one of
+ * them; from pinctrl-msm8998.c:
+ *
+ *   #define WEST  0x100000
+ *   #define NORTH 0x500000
+ *   #define EAST  0x900000
+ *   PINGROUP(id, base, ...):
+ *       ctl_reg = base + 0x1000 * id
+ *       io_reg  = base + 0x4 + 0x1000 * id
+ *
+ * and the ctl bit layout is fixed for this SoC:
+ *
+ *   mux_bit = 2 (3 bits)   pull_bit = 0 (2 bits)   drv_bit = 6 (3 bits)
+ *   oe_bit  = 9            io_reg: in_bit 0, out_bit 1
+ *
+ * GPIO 87 and 88 are EAST pins whose function list is
+ *   "gpio", "blsp_spi5", "blsp_uart2_b", "blsp_i2c5", ...
+ * so selecting I2C means mux = 3, not mux = 0. Getting either the tile or the
+ * mux index wrong silently drives the wrong pin, which is why the previous
+ * round only READ these registers.
+ *
+ * Pin numbers come straight from live.dtb:
+ *   qcom,i2c-clk  = <&tlmm 0x58 0>   -> GPIO 88 = SCL
+ *   qcom,i2c-dat  = <&tlmm 0x57 0>   -> GPIO 87 = SDA
+ *   synaptics,reset-gpio = <&tlmm 0x59 0> -> GPIO 89
+ */
+#define TLMM_BASE               0x3400000ULL
+#define TLMM_EAST               0x900000
+#define TLMM_NORTH              0x500000
+#define TLMM_WEST               0x100000
+#define TLMM_PIN_STRIDE         0x1000
+#define TLMM_GPIO_CFG           0x00
+#define TLMM_GPIO_IN_OUT        0x04
+
+#define TLMM_CTL_MUX_BIT        2
+#define TLMM_CTL_MUX_MASK       (0x7u << TLMM_CTL_MUX_BIT)
+#define TLMM_CTL_PULL_BIT       0
+#define TLMM_CTL_PULL_MASK      (0x3u << TLMM_CTL_PULL_BIT)
+#define TLMM_CTL_DRV_BIT        6
+#define TLMM_CTL_DRV_MASK       (0x7u << TLMM_CTL_DRV_BIT)
+/* drive-strength 16 mA == selector 3 in DT terms (pinctrl-msm maps 2mA steps) */
+#define TLMM_DRV_16             3u
+#define TLMM_CTL_OE_BIT         9
+/*
+ * TLMM io register (ctl + 0x04). Bit 0 is the live pad level, bit 1 is the
+ * output latch:
+ *
+ *   read  -> both bits reflect the pin, so a read-modify-write of bit 1 also
+ *            writes bit 0 back, a bit that is read-only on real hardware
+ *   write -> only bit 1 (and bit 0 on later TLMM revs) has meaning; bit 0 on
+ *            msm8998 is input-only
+ *
+ * Every user of this file therefore does the RMW through si2c_tlmm_io_wr(),
+ * which reads a masked copy and writes only the writable bits back.
+ */
+#define TLMM_IO_IN_BIT          0
+#define TLMM_IO_OUT_BIT         1
+#define TLMM_PULL_UP            3u              /* kKeeper-free pull up */
+#define TLMM_FUNC_BLSP_I2C5     3               /* index of blsp_i2c5 for 87/88 */
+
+#define SAGIT_PIN_SCL           88
+#define SAGIT_PIN_SDA           87
+#define SAGIT_PIN_RESET         89
+#define SAGIT_PIN_TOUCH_IRQ     125
+/*
+ * disp_vddts_vreg: the touch "vdd" rail in the mainline Mi 6 DTS is a
+ * regulator-fixed on TLMM gpio 50, enable-active-high, regulator-boot-on.
+ * (The Android DT calls the same rail "avdd"; the mainline tree calls it vdd,
+ * and gives the chip its 1.8 V IO rail separately from PM8998 LDO6.)
+ */
+#define SAGIT_PIN_TS_AVDD       50
+
+/*
+ * TLMM is split into tiles, and the tile is a property of the pin, not a range:
+ * mainline (drivers/pinctrl/qcom/pinctrl-msm8998.c) writes
+ *
+ *     PINGROUP(id, tile, ...)  ->  ctl_reg = tile_base + 0x1000 * id
+ *
+ * and the tile map is scattered:
+ *
+ *     GPIO 50          NORTH (0x500000)   touch avdd rail
+ *     GPIO 87, 88, 89  EAST  (0x900000)   sda, scl, reset
+ *     GPIO 125         EAST  (0x900000)   interrupt
+ *
+ * The previous version addressed every pin through the EAST base, so avdd on
+ * gpio 50 actually touched EAST+0x32000 -- a hole in the EAST window that no
+ * pin implements. That is a real bug: it drove nothing (so the rail stayed
+ * down) and an access to an unimplemented TLMM window can stall the
+ * interconnect on this SoC, which freezes the boot with no output at all.
+ */
+static volatile uint32_t *si2c_tlmm_east;
+static volatile uint32_t *si2c_tlmm_north;
+
+static volatile uint32_t *
+si2c_tlmm_tile(uint32_t pin)
+{
+	switch (pin) {
+	case SAGIT_PIN_TS_AVDD:
+		return si2c_tlmm_north;
+	default:
+		return si2c_tlmm_east;
+	}
+}
+
+static uint32_t
+si2c_tlmm_rd(uint32_t pin, uint32_t reg)
+{
+	volatile uint32_t *tile = si2c_tlmm_tile(pin);
+
+	if (tile == NULL) {
+		return 0xffffffffu;
+	}
+	return tile[(pin * TLMM_PIN_STRIDE + reg) / 4];
+}
+
+static void
+si2c_tlmm_wr(uint32_t pin, uint32_t reg, uint32_t v)
+{
+	volatile uint32_t *tile = si2c_tlmm_tile(pin);
+
+	if (tile != NULL) {
+		tile[(pin * TLMM_PIN_STRIDE + reg) / 4] = v;
+	}
+}
+
+/*
+ * Read side of the io register (ctl + 0x04) without the input bit.
+ *
+ * The io register packs the live pad level into bit 0 and the output latch
+ * into bit 1. Feeding a full read back into a write also writes bit 0, which
+ * is input-only on this TLMM: the write is either dropped or takes the whole
+ * register with it, and the output latch never changes. That is exactly the
+ * symptom v62-v63 show -- oe goes set (ctl 0x203 = mux 0, pull-up, oe bit 9)
+ * yet rst io stays 0x0 forever, so the latch was never programmed. Mask the
+ * input bit off on every read that is going back into a write.
+ */
+static uint32_t
+si2c_tlmm_io_rd(uint32_t pin)
+{
+	return si2c_tlmm_rd(pin, TLMM_GPIO_IN_OUT) &
+	    ~(1u << TLMM_IO_IN_BIT);
+}
+
+/*
+ * Program the output latch explicitly instead of OR-ing it into whatever the
+ * live level happens to be: output high drives the pad, and clearing either
+ * bit pulls a line low, so the latch has to be set, never inferred.
+ */
+static void
+si2c_tlmm_io_wr(uint32_t pin, int high)
+{
+	uint32_t v = si2c_tlmm_io_rd(pin);
+
+	if (high) {
+		v |= (1u << TLMM_IO_OUT_BIT);
+	} else {
+		/*
+		 * v64 emits  and w, w, #0xfffffffc  here (bit 0 and bit 1 both
+		 * cleared) because bit 1 of the masked read is known to the
+		 * compiler to be whatever the latch was. The intent is
+		 * "latch = 0", which is what it computes, so the line is
+		 * driven low either way; keep the readable form.
+		 */
+		v &= ~(1u << TLMM_IO_OUT_BIT);
+	}
+	si2c_tlmm_wr(pin, TLMM_GPIO_IN_OUT, v);
+}
+
+/*
+ * Assert the touch avdd rail (regulator-fixed on gpio 50, active high).
+ *
+ * Same ordering rule as the reset line: set the output value in io_reg before
+ * enabling the pad driver, so the pin never glitches low.
+ */
+static void
+si2c_avdd_on(void)
+{
+	uint32_t cfg = si2c_tlmm_rd(SAGIT_PIN_TS_AVDD, TLMM_GPIO_CFG);
+	uint32_t io;
+
+	/*
+	 * This pin is disp_vddts_vreg's enable: a regulator-fixed on gpio 50,
+	 * enable-active-high, regulator-boot-on, startup-delay-us = 4000. On the
+	 * Mi 6 that enable drives U1100, the load switch that produces the
+	 * touch panel's 3.1 V main rail, so the ordering below matters:
+	 *
+	 *   1. program the output latch HIGH while the driver is still off, so
+	 *      enabling the pad never injects a low glitch that would drop the
+	 *      load switch and make it restart
+	 *   2. enable the output driver (function 0, no pull)
+	 *   3. leave the 4 ms rail delay to the caller
+	 *
+	 * The old order wrote the latch first but then a second write could
+	 * still land while oe was being set; do it as an explicit read-back now.
+	 */
+	cfg &= ~(TLMM_CTL_MUX_MASK | TLMM_CTL_PULL_MASK | TLMM_CTL_OE_BIT);
+	cfg |= (0u << TLMM_CTL_MUX_BIT);        /* function 0 = plain GPIO */
+
+	/* latch high with the driver still disabled */
+	si2c_tlmm_io_wr(SAGIT_PIN_TS_AVDD, 1);
+	si2c_tlmm_wr(SAGIT_PIN_TS_AVDD, TLMM_GPIO_CFG, cfg);
+
+	/* now enable the driver; the pad comes up already high */
+	cfg |= (1u << TLMM_CTL_OE_BIT);
+	si2c_tlmm_wr(SAGIT_PIN_TS_AVDD, TLMM_GPIO_CFG, cfg);
+
+	io = si2c_tlmm_rd(SAGIT_PIN_TS_AVDD, TLMM_GPIO_IN_OUT);
+	si2c.avdd_io_after = io;
+	si2c.avdd_cfg_after = si2c_tlmm_rd(SAGIT_PIN_TS_AVDD, TLMM_GPIO_CFG);
+}
+
+/*
+ * Wait about `us` microseconds without delay(): spin on `yield`, the same trick
+ * the UFS driver uses. Each iteration is a handful of cycles, so 2000 yields is
+ * a convenient unit ("one tick"); on Kryo at 1.9 GHz that is on the order of a
+ * few microseconds. Precision does not matter here -- only that it waits long
+ * enough for the rail to settle.
+ */
+static void
+si2c_settle(uint32_t ticks)
+{
+	for (uint32_t t = 0; t < ticks; t++) {
+		for (volatile uint32_t i = 0; i < 2000; i++) {
+			__asm__ volatile("yield" ::: "memory");
+		}
+	}
+}
+
+/*
+ * Millisecond-granularity wait.
+ *
+ * The Synaptics part needs tens of milliseconds to come out of reset (the
+ * mainline Mi 6 DT says syna,reset-delay-ms = 20 and syna,startup-delay-ms =
+ * 20). si2c_settle() is a few microseconds per tick, so 20 ms is ~10000
+ * ticks; measured generously at ~2 us per tick, 12000 ticks covers it with
+ * margin and still finishes well inside the watchdog budget.
+ */
+#define SAGIT_TICKS_PER_MS      600u
+
+static void
+si2c_wait_ms(uint32_t ms)
+{
+	si2c_settle(ms * SAGIT_TICKS_PER_MS);
+}
+
+/*
+ * Mux SCL/SDA onto BLSP I2C and enable pull-ups.
+ *
+ * The I2C lines are open drain: the controller only ever pulls them low, and
+ * something has to pull them back up. The DT's i2c_1_sleep state asks for
+ * bias-pull-up on exactly these pins, so that is what we program.
+ *
+ * mux index 3 is "blsp_i2c5" for GPIO 87/88 (see the function list above).
+ */
+static void
+si2c_pins_to_i2c(void)
+{
+	uint32_t ctl;
+	uint32_t pins[2] = { SAGIT_PIN_SCL, SAGIT_PIN_SDA };
+
+	for (int i = 0; i < 2; i++) {
+		ctl = si2c_tlmm_rd(pins[i], TLMM_GPIO_CFG);
+		ctl &= ~(TLMM_CTL_MUX_MASK | TLMM_CTL_PULL_MASK |
+		    TLMM_CTL_OE_BIT);
+		ctl |= (TLMM_FUNC_BLSP_I2C5 << TLMM_CTL_MUX_BIT);
+		ctl |= (TLMM_PULL_UP << TLMM_CTL_PULL_BIT);
+		si2c_tlmm_wr(pins[i], TLMM_GPIO_CFG, ctl);
+	}
+}
+
+/*
+ * Touch reset (GPIO 89).
+ *
+ * v64 lesson: every attempt that relied on "RESET is active low, release by
+ * pull-up" left the line at 0 and the part silent. The vendor device tree in
+ * the bootloader image (live.dtb) disagrees with that reading:
+ *
+ *   synaptics,reset-on-state  = <0>    <- the pin level that means "running"
+ *   synaptics,reset-active-ms = <5>    <- time to hold the reset state
+ *   synaptics,reset-delay-ms  = <200>  <- wait after releasing
+ *   synaptics,power-delay-ms  = <5>
+ *   synaptics,ub-i2c-addr     = <0x2c>
+ *
+ * and the pin config groups do not describe an input either:
+ *
+ *   ts_reset_active  : gpio89, drive-strength <16>, bias-pull-up
+ *   ts_reset_suspend1: gpio89, drive-strength <2>,  bias-pull-down
+ *
+ * There is no output-high / input-enable anywhere for gpio89, and
+ * "reset-on-state = 0" means the normal (running) level of the line is 0. So
+ * this is an active-HIGH reset whose idle level is low: the host must drive it
+ * HIGH to release, and the pull-up alone can never do that (a pull-up with the
+ * driver off is *not* the same thing as a driven high, which is why rst io
+ * stayed 0 for v59-v64).
+ *
+ * New sequence:
+ *   1. drive LOW  (reset asserted)       and wait reset-active-ms  (5 ms)
+ *   2. drive HIGH (reset deasserted)     and wait reset-delay-ms   (200 ms)
+ * The line is left DRIVEN HIGH, so the part never loses its release.
+ */
+static void
+si2c_reset_release(void)
+{
+	uint32_t cfg;
+	uint32_t io;
+
+	cfg = si2c_tlmm_rd(SAGIT_PIN_RESET, TLMM_GPIO_CFG);
+	si2c.rst_cfg_start = cfg;
+
+	/*
+	 * Function 0 (plain GPIO), pull-up, output driver ON, and an explicit
+	 * drive strength.
+	 *
+	 * The vendor ts_reset_active group asks for drive-strength = <16>, but
+	 * every version of this file so far left the DRV field at 0 -- the
+	 * weakest setting. cfg stayed 0x203 (= mux 0, pull-up, oe), which is what
+	 * the screen kept showing while the part never came out of reset.
+	 */
+	cfg &= ~(TLMM_CTL_MUX_MASK | TLMM_CTL_PULL_MASK | TLMM_CTL_OE_BIT |
+	    TLMM_CTL_DRV_MASK);
+	cfg |= (TLMM_PULL_UP << TLMM_CTL_PULL_BIT);
+	cfg |= (TLMM_DRV_16 << TLMM_CTL_DRV_BIT);
+	cfg |= (1u << TLMM_CTL_OE_BIT);
+
+	/* 1. assert: drive low, then enable the driver. */
+	si2c_tlmm_io_wr(SAGIT_PIN_RESET, 0);
+	si2c_tlmm_wr(SAGIT_PIN_RESET, TLMM_GPIO_CFG, cfg);
+	si2c.rst_cfg_low = si2c_tlmm_rd(SAGIT_PIN_RESET, TLMM_GPIO_CFG);
+	si2c_wait_ms(5);                        /* reset-active-ms */
+
+	/* 2. deassert: drive high and LEAVE IT DRIVEN. */
+	si2c_tlmm_io_wr(SAGIT_PIN_RESET, 1);
+	si2c.rst_cfg_after = si2c_tlmm_rd(SAGIT_PIN_RESET, TLMM_GPIO_CFG);
+	io = si2c_tlmm_rd(SAGIT_PIN_RESET, TLMM_GPIO_IN_OUT);
+	/*
+	 * If the pad still reads 0 with the driver on and the latch high, we
+	 * are being fought by the chip -- record it rather than guess later.
+	 */
+	si2c.rst_driven_high = (io >> 1) & 1u;
+}
+
+/*
+ * Touch interrupt line (GPIO 125): same pinctrl group, input with a pull-up.
+ * Not used for anything yet (this probe is polled), but configuring it the way
+ * the reference design does avoids leaving it in whatever the bootloader set.
+ */
+static void
+si2c_irq_pin_input(void)
+{
+	uint32_t cfg = si2c_tlmm_rd(SAGIT_PIN_TOUCH_IRQ, TLMM_GPIO_CFG);
+
+	cfg &= ~(TLMM_CTL_MUX_MASK | TLMM_CTL_PULL_MASK | TLMM_CTL_OE_BIT);
+	cfg |= (0u << TLMM_CTL_MUX_BIT);
+	cfg |= (TLMM_PULL_UP << TLMM_CTL_PULL_BIT);
+	si2c_tlmm_wr(SAGIT_PIN_TOUCH_IRQ, TLMM_GPIO_CFG, cfg);
+}
+
+
+/*
+ * A dead or unconfigured I2C bus shows up as SCL/SDA stuck low (no pull-ups, or
+ * the controller is not driving). Reporting the raw pin registers separates
+ * "pins are wrong" from "pins are fine but the chip is not answering".
+ */
+static void
+si2c_pin_report(const char *what, uint32_t extra)
+{
+	uint32_t scl_cfg = si2c_tlmm_rd(SAGIT_PIN_SCL, TLMM_GPIO_CFG);
+	uint32_t scl_io = si2c_tlmm_rd(SAGIT_PIN_SCL, TLMM_GPIO_IN_OUT);
+	uint32_t sda_cfg = si2c_tlmm_rd(SAGIT_PIN_SDA, TLMM_GPIO_CFG);
+	uint32_t sda_io = si2c_tlmm_rd(SAGIT_PIN_SDA, TLMM_GPIO_IN_OUT);
+	uint32_t rst_cfg = si2c_tlmm_rd(SAGIT_PIN_RESET, TLMM_GPIO_CFG);
+	uint32_t rst_io = si2c_tlmm_rd(SAGIT_PIN_RESET, TLMM_GPIO_IN_OUT);
+
+	panic("SAGIT touch: %s (rc=%d)\n"
+	    " glink rc=%d st=0x%x ack(id/kind/err)=%u/%u/0x%x "
+	    "| tx o/s/h/t=0x%x/0x%x/0x%x/0x%x "
+	    "| rx o/s/h/t=0x%x/0x%x/0x%x/0x%x\n"
+	    " rpm toc/cnt=0x%x/%u | smem rc/magic=%d/0x%x | phys=0x%x/0x%x\n"
+	    " i2c st=0x%x err=0x%x ist=0x%x txn=%d | rst 0x%x/0x%x drv=%d "
+	    "| avdd=0x%x/0x%x | scl=0x%x/0x%x sda=0x%x/0x%x\n"
+	    " pmic(rc/ver/apid/st)=%d/0x%x/0x%x/0x%x",
+	    what, (int)extra,
+	    (int)si2c.glink_rc, si2c.glink_state, si2c.glink_ack,
+	    si2c.glink_ack_kind, si2c.glink_ack_err,
+	    si2c.glink_tx_off, si2c.glink_tx_sz, si2c.glink_tx_h, si2c.glink_tx_t,
+	    si2c.glink_rx_off, si2c.glink_rx_sz, si2c.glink_rx_h, si2c.glink_rx_t,
+	    si2c.rpm_toc_magic, si2c.rpm_toc_count,
+	    (int)si2c.smem_rc, si2c.smem_magic,
+	    si2c.phys_base, si2c.phys_size,
+	    si2c_rdq(QUP_STATE), si2c_rdq(QUP_ERROR_FLAGS), si2c_rdq(QUP_I2C_STATUS),
+	    (int)si2c.txn,
+	    rst_cfg, rst_io, (int)si2c.rst_driven_high,
+	    si2c.avdd_cfg_after, si2c.avdd_io_after,
+	    scl_cfg, scl_io, sda_cfg, sda_io,
+	    (int)si2c.pmic_rc, si2c.pmic_ver, si2c.pmic_apid, si2c.pmic_st);
+}
+
+void
+sagit_i2c_touch_probe(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	uint8_t idbuf[8] = { 0 };
+	int rc;
+
+	si2c.txn = 0;
+
+	/*
+	 * Feasibility gate for the RPM path. v89 showed PM8998's LDO6 has no
+	 * SPMI APID at all, so switching that rail on requires talking to the
+	 * RPM over G-Link -- which in turn requires SMEM. Probe it first: if
+	 * SMEM cannot even be mapped and read at bsd_init() time, no amount of
+	 * G-Link code would help, and this one boot answers that question.
+	 */
+	{
+		struct sagit_smem_report sr;
+		struct sagit_rpm_ram_report rr;
+		vm_offset_t pb = 0;
+		vm_size_t ps = 0;
+
+		sagit_smem_physmap(&pb, &ps);
+		si2c.phys_base = (uint32_t)pb;
+		si2c.phys_size = (uint32_t)ps;
+
+		si2c.smem_rc = (uint32_t)sagit_smem_probe(&sr);
+		if (si2c.smem_rc == 0) {
+			si2c.smem_magic = sr.magic;
+			si2c.smem_entries = sr.found;
+			si2c.smem_rpm_item = sr.rpm_item_offset;
+		}
+		/* Probe RPM msg RAM unconditionally: SMEM magic may fail while the
+		 * cached alias still works, and the TOC is the decisive test of
+		 * whether XNU can read RPM RAM at all. */
+		si2c.rpm_ram_rc = (uint32_t)sagit_smem_probe_rpm_ram(&rr);
+		si2c.rpm_toc_magic = rr.toc_magic;
+		si2c.rpm_toc_count = rr.toc_count;
+		si2c.rpm_w0 = rr.w0;
+		si2c.rpm_w1 = rr.w1;
+
+		/* Vote PM8998 LDO6 (touch vdd) on through the RPM over G-Link.
+		 * All access uses the cached alias already proven by the TOC read. */
+		{
+			struct sagit_glink_report gr;
+			si2c.glink_rc = (uint32_t)sagit_glink_ldo6_on(&gr);
+			si2c.glink_state = gr.state;
+			si2c.glink_ack = gr.ack_msg_id;
+			si2c.glink_ack_kind = gr.ack_kind;
+			si2c.glink_ack_err = gr.ack_err;
+			si2c.glink_tx_off = gr.tx_off; si2c.glink_tx_sz = gr.tx_sz;
+			si2c.glink_rx_off = gr.rx_off; si2c.glink_rx_sz = gr.rx_sz;
+			si2c.glink_tx_h = gr.tx_head0; si2c.glink_tx_t = gr.tx_tail0;
+			si2c.glink_rx_h = gr.rx_head0; si2c.glink_rx_t = gr.rx_tail0;
+		}
+	}
+
+	/*
+	 * Breadcrumbs, one line per stage.
+	 *
+	 * v43 proved why these are needed: the screen stopped at "inittodr done"
+	 * with no SAGIT I2C line at all, even though every failure path in this
+	 * file ends in panic(). A panic always prints, so the probe was not
+	 * failing -- it was *stuck*, long enough for the SoC watchdog to reset
+	 * the board. printf works at this point (the B09 line just above is
+	 * printed by bsd_init microseconds earlier), so a line per stage is what
+	 * turns "it froze somewhere" into "it froze here".
+	 *
+	 * The last line on screen is therefore the last stage that survived.
+	 */
+	si2c_stage(1);
+	printf("SAGIT I2C 1/9 enter, addr=0x%x\n", SAGIT_TOUCH_ADDR);
+
+	if (SecureDTLookupEntry(NULL, "/sagit-i2c", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t)) {
+		panic("SAGIT I2C: no /sagit-i2c node in the device tree");
+	}
+	si2c_stage(2);
+	printf("SAGIT I2C 2/9 node reg=0x%lx len=0x%lx\n",
+	    (unsigned long)(uint32_t)reg[0], (unsigned long)(uint32_t)reg[1]);
+
+	si2c.regs = (volatile uint32_t *)ml_io_map(reg[0], reg[1]);
+	if (si2c.regs == NULL) {
+		panic("SAGIT I2C: ml_io_map(i2c) failed");
+	}
+	/*
+	 * GCC is a separate window. The values come from this phone's ADT:
+	 *
+	 *     //soc/qcom,gcc@100000
+	 *         compatible = "qcom,gcc-8998-v2"
+	 *         reg        = <0x100000 0xb0000>
+	 *
+	 * Through v46 this file mapped 0xc000000 (mainline's address space, not
+	 * this phone's), 0xb00000 away from the real block: the first read of it
+	 * hung the board at stage 8.
+	 *
+	 * v47/v48 then tried to read the base from the device tree and both
+	 * failed -- SecureDTLookupEntry (path, strcmp on node names) and
+	 * SecureDTFindEntry (compatible match) each reported "not found". The
+	 * kernel's copy of the tree evidently does not carry the soc nodes, so
+	 * the device tree is not a usable source for this address in the
+	 * bsd_init context.
+	 *
+	 * Therefore: look it up, and if that fails use the ADT value. Both paths
+	 * print what they chose, so a wrong assumption is visible on screen
+	 * instead of silently hanging.
+	 */
+	{
+		DTEntry gcc;
+		uintptr_t const *greg = NULL;
+		unsigned int gsize = 0;
+		uint64_t gcc_base = SAGIT_GCC_BASE_ADT;
+		uint64_t gcc_size = SAGIT_GCC_SIZE_ADT;
+
+		if (SecureDTFindEntry("compatible", "qcom,gcc-8998-v2", &gcc) ==
+		    kSuccess ||
+		    SecureDTFindEntry("compatible", "qcom,gcc-8998", &gcc) ==
+		    kSuccess) {
+			if (SecureDTGetProperty(gcc, "reg", (void const **)&greg,
+			    &gsize) == kSuccess && gsize >= 2 * sizeof(uintptr_t)) {
+				gcc_base = greg[0];
+				gcc_size = greg[1];
+				printf("SAGIT I2C gcc: from device tree\n");
+			}
+		} else {
+			printf("SAGIT I2C gcc: device tree has no gcc node, "
+			    "using ADT values\n");
+		}
+		si2c_stage(12);
+		if (gcc_size < SAGIT_BLSP1_AHB_HALT + 4) {
+			panic("SAGIT I2C: gcc window 0x%llx too small for "
+			    "offset 0x%x", (unsigned long long)gcc_size,
+			    (unsigned)SAGIT_BLSP1_AHB_HALT);
+		}
+		printf("SAGIT I2C gcc: base=0x%llx size=0x%llx\n",
+		    (unsigned long long)gcc_base, (unsigned long long)gcc_size);
+
+		si2c.gcc = (volatile uint32_t *)ml_io_map(gcc_base, gcc_size);
+		if (si2c.gcc == NULL) {
+			panic("SAGIT I2C: ml_io_map(gcc) failed at 0x%llx",
+			    (unsigned long long)gcc_base);
+		}
+		/*
+		 * (v49 dereferenced greg[1] here to re-check the window size. greg is
+		 * only set on the device-tree path, so on the ADT fallback it was
+		 * NULL and the read faulted at address 0x8 -- a kernel data abort
+		 * inside the probe. The size check above already covers both paths;
+		 * nothing may touch greg after this point.)
+		 */
+	}
+	/*
+	 * TLMM: map the two tiles the touch pins live in, not the whole
+	 * 0xc00000 block -- that needs a 12 MiB contiguous kmem allocation and
+	 * fails this early (kmem_alloc ... 12582912 ... failed with 3).
+	 * Inside a tile the register offset is 0x1000 * gpio, so a window is
+	 * only as big as the highest pin in that tile demands: EAST needs
+	 * 0x84000 to reach gpio 125, NORTH needs 0x40000 to reach gpio 50.
+	 */
+	si2c_tlmm_east  = (volatile uint32_t *)ml_io_map(TLMM_BASE + TLMM_EAST, 0x84000);
+	si2c_tlmm_north = (volatile uint32_t *)ml_io_map(TLMM_BASE + TLMM_NORTH, 0x40000);
+	if (si2c_tlmm_east == NULL || si2c_tlmm_north == NULL) {
+		panic("SAGIT I2C: ml_io_map(tlmm) failed east=%p north=%p",
+		    (void *)si2c_tlmm_east, (void *)si2c_tlmm_north);
+	}
+	si2c_stage(3);
+	printf("SAGIT I2C 3/9 mapped i2c/gcc/east/north ok\n");
+
+	/*
+	 * Power and pin order:
+	 *   1. avdd rail (gpio 50) -- the chip cannot answer without it
+	 *   2. bus mux + pull-ups
+	 *   3. reset released, after the rail has settled
+	 * Only then is it worth starting clocks.
+	 */
+	si2c_stage(4);
+	si2c.avdd_cfg_before = si2c_tlmm_rd(SAGIT_PIN_TS_AVDD, TLMM_GPIO_CFG);
+	si2c.avdd_io_before = si2c_tlmm_rd(SAGIT_PIN_TS_AVDD, TLMM_GPIO_IN_OUT);
+	printf("SAGIT I2C 4/9 avdd before: cfg=0x%x io=0x%x\n",
+	    si2c.avdd_cfg_before, si2c.avdd_io_before);
+	si2c_avdd_on();
+	/*
+	 * disp_vddts_vreg asks for startup-delay-us = 4000 before anything may
+	 * use the rail, and on the Mi 6 that enable drives U1100 -- the load
+	 * switch behind the touch panel's 3.1 V main rail. Give it a wide margin
+	 * before the SPMI write so the two rails are never sequenced against
+	 * each other.
+	 */
+	si2c_wait_ms(10);
+	/*
+	 * PM8998 LDO6 is NOT reachable over SPMI as a peripheral.
+	 *
+	 * v87 proved it: driver pm8998_l6 is declared as
+	 *     { "l6", QCOM_SMD_RPM_LDOA, 6, &pm8998_pldo, "vdd_l6" }
+	 * in qcom_smd-regulator.c -- an RPM/SMD resource -- and
+	 * qcom_spmi-regulator.c contains no pm8998 table at all. So there is no
+	 * APID for PPID 0x45, which is exactly what the probe kept reporting
+	 * (apid=0xffffffff, rc=ENOENT); the earlier apid=0x28 came from the
+	 * high-nibble fallback and pointed at an unrelated peripheral.
+	 *
+	 * Turning LDO6 on therefore needs RPM-SMD, a separate subsystem. Until
+	 * then the touch part is powered by what the bootloader left plus the
+	 * U1100 load switch that gpio 50 enables, and that is enough to find out
+	 * whether the chip answers I2C at all.
+	 *
+	 * sagit_pmic=1 re-enables the old SPMI attempt for experiments.
+	 */
+	{
+		/*
+		 * v88 skipped the SPMI attempt and the part still did not answer,
+		 * so this round runs it again -- but now purely as a diagnostic:
+		 * it dumps the whole APID -> PPID table. Either PPID 0x45 is in
+		 * the table (the lookup was wrong) or it is not (this arbiter does
+		 * not expose PM8998's LDOs and RPM is required).
+		 */
+		int want_pmic = 1;
+
+		PE_parse_boot_argn("sagit_pmic", &want_pmic, sizeof(want_pmic));
+		if (want_pmic != 0) {
+			struct sagit_pmic_report pmr;
+			int prc;
+
+			memset(&pmr, 0, sizeof(pmr));
+			prc = sagit_pmic_ldo6_on(&pmr);
+			si2c.pmic_rc = (uint32_t)prc;
+			si2c.pmic_ver = pmr.version;
+			si2c.pmic_apid = pmr.apid;
+			si2c.pmic_st = pmr.enable_status;
+			si2c.pmic_en_rb = pmr.enable_rb;
+			si2c.pmic_md_rb = pmr.mode_rb;
+			si2c.pmic_owner = pmr.owner;
+			si2c.pmic_md_before = pmr.mode_before;
+			si2c.pmic_rg_rb = pmr.range_rb;
+			si2c.pmic_sv_rb = pmr.set_rb;
+			si2c.pmic_type_rb = pmr.type_rb;
+			si2c.pmic_subtype_rb = pmr.subtype_rb;
+		} else {
+			si2c.pmic_rc = 0xffff0000u;     /* skipped on purpose */
+		}
+	}
+	si2c_stage(5);
+	printf("SAGIT I2C 5/9 avdd after: cfg=0x%x io=0x%x\n",
+	    si2c_tlmm_rd(SAGIT_PIN_TS_AVDD, TLMM_GPIO_CFG),
+	    si2c_tlmm_rd(SAGIT_PIN_TS_AVDD, TLMM_GPIO_IN_OUT));
+	/*
+	 * Power-up ordering, per drivers/input/rmi4/rmi_i2c.c:
+	 *
+	 *   regulator_bulk_enable(vdd, vio);
+	 *   msleep(syna,startup-delay-ms);     <- BEFORE reset
+	 *   ... reset pulse ...
+	 *   msleep(syna,reset-delay-ms);
+	 *   first i2c access
+	 *
+	 * This driver had no startup wait at all: avdd and LDO6 came up and the
+	 * reset pulse started immediately, with si2c_settle(2) standing in for
+	 * the rail delay (that is ~4 microseconds, not the 5 ms the vendor DT
+	 * asks for in synaptics,power-delay-ms). The part was being reset while
+	 * its supplies were still ramping.
+	 */
+	/*
+	 * Generous power-up and startup waits. si2c_wait_ms() is a calibrated
+	 * spin (SAGIT_TICKS_PER_MS), not a timer, so it can only over- or
+	 * under-shoot; use 20 ms (and a further 20 ms margin) instead of the
+	 * bare 5 ms from synaptics,power-delay-ms. Over-waiting costs a few
+	 * milliseconds of boot time; under-waiting costs a boot cycle.
+	 */
+	si2c_wait_ms(20);               /* power-delay-ms: rails settled */
+	si2c_wait_ms(20);               /* startup margin before reset */
+	si2c_pins_to_i2c();
+	si2c_stage(6);
+	printf("SAGIT I2C 6/9 pins: scl cfg=0x%x io=0x%x | sda cfg=0x%x io=0x%x\n",
+	    si2c_tlmm_rd(SAGIT_PIN_SCL, TLMM_GPIO_CFG),
+	    si2c_tlmm_rd(SAGIT_PIN_SCL, TLMM_GPIO_IN_OUT),
+	    si2c_tlmm_rd(SAGIT_PIN_SDA, TLMM_GPIO_CFG),
+	    si2c_tlmm_rd(SAGIT_PIN_SDA, TLMM_GPIO_IN_OUT));
+	si2c_reset_release();
+	si2c_irq_pin_input();
+	si2c_stage(7);
+	printf("SAGIT I2C 7/9 rst cfg=0x%x io=0x%x | irq cfg=0x%x io=0x%x\n",
+	    si2c_tlmm_rd(SAGIT_PIN_RESET, TLMM_GPIO_CFG),
+	    si2c_tlmm_rd(SAGIT_PIN_RESET, TLMM_GPIO_IN_OUT),
+	    si2c_tlmm_rd(SAGIT_PIN_TOUCH_IRQ, TLMM_GPIO_CFG),
+	    si2c_tlmm_rd(SAGIT_PIN_TOUCH_IRQ, TLMM_GPIO_IN_OUT));
+	/*
+	 * 200 ms startup, the vendor's synaptics,reset-delay-ms from live.dtb.
+	 * This used to be 1000 ms borrowed from the msm8998 Yoshino boards,
+	 * but those boards use a different panel -- the vendor value for THIS
+	 * panel is 200 ms, and 1000 ms only cost boot time.
+	 */
+	si2c_wait_ms(200);              /* reset release -> part booted */
+	/* Stage 8 is the freeze point of v44 and v45: the very first GCC
+	 * read happens on the next line, so mark it before going in. */
+	si2c_stage(8);
+
+	printf("SAGIT I2C 8/9 clocks before: rcgr=0x%x ahb=0x%x ahbhalt=0x%x\n",
+	    si2c_rdg(SAGIT_QUP5_RCGR), si2c_rdg(SAGIT_BLSP1_AHB_CBCR),
+	    si2c_rdg(SAGIT_BLSP1_AHB_HALT));
+
+	rc = si2c_clock_up();
+	si2c_stage(9);
+
+	/*
+	 * Print the clock registers whether or not the bring-up succeeded, and
+	 * print them BEFORE the first QUP access. v44 froze on that first access,
+	 * which lost the state we needed; this ordering means the last line on
+	 * screen already carries the answer.
+	 */
+	printf("SAGIT I2C 9/9 clocks after: rc=%d rcgr=0x%x cfg=0x%x n=0x%x "
+	    "d=0x%x cbcr=0x%x ahb=0x%x ahbhalt=0x%x bcr=0x%x\n",
+	    rc, si2c_rdg(SAGIT_QUP5_RCGR + RCG_CMD_REG),
+	    si2c_rdg(SAGIT_QUP5_RCGR + RCG_CFG_REG),
+	    si2c_rdg(SAGIT_QUP5_RCGR + RCG_N_REG),
+	    si2c_rdg(SAGIT_QUP5_RCGR + RCG_D_REG),
+	    si2c_rdg(SAGIT_QUP5_CBCR), si2c_rdg(SAGIT_BLSP1_AHB_CBCR),
+	    si2c_rdg(SAGIT_BLSP1_AHB_HALT), si2c_rdg(SAGIT_QUP5_BCR));
+
+	if (rc != 0) {
+		/*
+		 * Classified, and now an intentional panic: the two codes map to
+		 * the two things a bare-register clock bring-up can get wrong.
+		 */
+		si2c_clock_report(rc == EAGAIN ?
+		    "RCG root did not start" : "BLSP1 AHB still halted",
+		    (uint32_t)rc);
+	}
+
+	si2c_stage(10);
+	printf("SAGIT I2C qup: touching block 0xc179000 now (a freeze here means "
+	    "the QUP block is not powered/clocked)\n");
+
+	rc = si2c_qup_init();
+	if (rc != 0) {
+		si2c_report("qup init failed", si2c_rdq(QUP_CONFIG),
+		    si2c_rdq(QUP_STATE), si2c_rdq(QUP_IO_MODE), (uint32_t)rc);
+	}
+	printf("SAGIT I2C qup: ready qstate=0x%x qcfg=0x%x iomode=0x%x\n",
+	    si2c_rdq(QUP_STATE), si2c_rdq(QUP_CONFIG), si2c_rdq(QUP_IO_MODE));
+
+	/*
+	 * RMI4 addressing: the chip is not a plain register device. A transfer
+	 * is always 2 bytes of address followed by data, and the first thing a
+	 * host reads is the page descriptor at address 0x0000 (function
+	 * presence and version). rmi4_i2c does exactly this at probe time.
+	 *
+	 * Read 6 bytes from 0x0000: enough for the page descriptor (which
+	 * reports how many functions and how their bits are distributed).
+	 */
+	si2c_stage(11);
+	printf("SAGIT I2C read: page0 @0x00, 6 bytes\n");
+	/*
+	 * Try both addresses a Synaptics part answers on:
+	 *   0x20  normal mode (RMI4 page descriptors available)
+	 *   0x2c  ROM bootloader mode
+	 * The page descriptor at 0x0000 is the RMI4 discovery entry point and is
+	 * what rmi4_i2c reads at probe time.
+	 */
+	rc = si2c_read_rmi4(SAGIT_TOUCH_ADDR, 0x0000, idbuf, sizeof(idbuf));
+	if (rc == 0) {
+		panic("SAGIT I2C OK: touch@0x%02x page0 = %02x %02x %02x %02x "
+		    "%02x %02x (qop=0x%x) scl io=0x%x sda io=0x%x -- I2C link is "
+		    "up, device in NORMAL mode",
+		    SAGIT_TOUCH_ADDR, idbuf[0], idbuf[1], idbuf[2], idbuf[3],
+		    idbuf[4], idbuf[5], si2c_rdq(QUP_OPERATIONAL),
+		    si2c_tlmm_rd(SAGIT_PIN_SCL, TLMM_GPIO_IN_OUT),
+		    si2c_tlmm_rd(SAGIT_PIN_SDA, TLMM_GPIO_IN_OUT));
+	}
+
+	/* Not at 0x20: the part may be sitting in ROM bootloader at 0x2c. */
+	rc = si2c_read_rmi4(SAGIT_TOUCH_UB_ADDR, 0x0000, idbuf, sizeof(idbuf));
+	if (rc == 0) {
+		panic("SAGIT I2C OK: touch@0x%02x page0 = %02x %02x %02x %02x "
+		    "%02x %02x (qop=0x%x) scl io=0x%x sda io=0x%x -- I2C link is "
+		    "up, device in BOOTLOADER mode (needs a firmware reload)",
+		    SAGIT_TOUCH_UB_ADDR, idbuf[0], idbuf[1], idbuf[2], idbuf[3],
+		    idbuf[4], idbuf[5], si2c_rdq(QUP_OPERATIONAL),
+		    si2c_tlmm_rd(SAGIT_PIN_SCL, TLMM_GPIO_IN_OUT),
+		    si2c_tlmm_rd(SAGIT_PIN_SDA, TLMM_GPIO_IN_OUT));
+	}
+
+	/* Neither address answered: report the full state, as before. */
+	si2c_pin_report(rc == ETIMEDOUT ? "read timed out" : "read failed",
+	    (uint32_t)rc);
+}
+
+#endif /* SAGIT */
diff --git a/bsd/dev/sagit_pmic.c b/bsd/dev/sagit_pmic.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sagit_pmic.c
--- /dev/null
+++ b/bsd/dev/sagit_pmic.c
@@ -0,0 +1,468 @@
+/*
+ * SAGIT: minimal SPMI write to bring up the touch controller's power rail.
+ *
+ * WHY THIS FILE EXISTS
+ * --------------------
+ * The touch part (Synaptics S3330/S3331/TD4322) needs several rails:
+ *
+ *   avdd -> disp_vddts_vreg, a regulator-fixed on TLMM gpio 50   (sagit_i2c.c)
+ *   vdd  -> pm8998_l6, PM8998 LDO6, reachable only over SPMI     (here)
+ *
+ * By v65 every other link in the chain was proven good: GCC clocks running,
+ * QUP in RUN, SCL/SDA idle high, reset finally driven high (rst io=0x3).
+ * Both touch I2C addresses still timed out with qerr=0, i.e. nothing on the
+ * bus answered -- the classic signature of an unpowered part. This kernel has
+ * no SPMI driver, so the rail had never been switched on from the OS side.
+ *
+ * HARDWARE FACTS
+ * --------------
+ * From live.dtb, /soc/qcom,spmi@800f000 (qcom,spmi-pmic-arb), reg-names:
+ *
+ *   core    0x0800f000  version, APID -> PPID map
+ *   chnls   0x08400000  TX channel registers
+ *   obsrvr  0x09400000  RX (observer) channel registers
+ *   cnfg    0x0800a000  APID ownership table
+ *
+ * From drivers/spmi/spmi-pmic-arb.c (this part reports version 0x30000000,
+ * which selects the v3 ops -- and v3 reuses the v2 offset/cmd helpers):
+ *
+ *   ppid        = (sid << 8) | ((addr >> 8) & 0xff)
+ *   apid map     core + 0x800 + 4 * n, PPID in bits 19:8, mask 0xfff
+ *   apid owner   cnfg + 0x700 + 4 * apid, low 3 bits = EE allowed to write
+ *   chnl offset  0x1000 * ee + 0x8000 * apid        (both channel types)
+ *   TX regs      chnls  + that offset: +0x00 CMD, +0x04 CONFIG,
+ *                                      +0x08 STATUS, +0x10 WDATA0
+ *   RX regs      obsrvr + that offset: +0x00 CMD, +0x08 STATUS, +0x18 RDATA0
+ *   command      (opc << 27) | ((addr & 0xff) << 4) | (len - 1)
+ *                opc 14 = WRITE, 15 = READ
+ *   data word    payload bytes only, lowest byte first
+ *   status       BIT0 DONE, BIT1 FAILURE, BIT2 DENIED, BIT3 DROPPED
+ *
+ * From drivers/regulator/qcom_spmi-regulator.c, pm8998_regulators[]:
+ *
+ *   "l6" -> base 0x4500     ENABLE 0x4546 bit7, MODE 0x4545 bit7
+ *                           RANGE  0x4540, VOLTAGE_SET 0x4541
+ *
+ * Writing an APID that belongs to another execution environment is an access
+ * violation that HANGS this SoC rather than returning an error, so ownership
+ * is checked before any store (see pmic_check_owner()).
+ *
+ * Everything here is polled and bounded: no regulator framework, no IRQs, no
+ * sleeps beyond short bounded spins.
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <machine/machine_routines.h>
+#include <libkern/libkern.h>
+
+#include "sagit_pmic.h"
+
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer. */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#if defined(SAGIT)
+
+/* ------------------------------------------------------------------ windows */
+
+#define PMIC_ARB_CORE_BASE      0x800f000ULL
+/*
+ * core is 0x1000 in the DT. The last APID map entry sits at core+0xffc, and on
+ * this SoC an access one byte past a mapping hangs the interconnect instead of
+ * faulting, so ask for 0x2000 and keep every access well inside.
+ */
+#define PMIC_ARB_CORE_SIZE      0x2000
+#define PMIC_ARB_CHNLS_BASE     0x8400000ULL
+#define PMIC_ARB_OBSVR_BASE     0x9400000ULL
+#define PMIC_ARB_CNFG_BASE      0x800a000ULL
+/* One 4 KiB page covers a channel (0x20 bytes of registers). v77 mapped 16 KiB
+ * at once and hung right after the store, so stay inside a single page. */
+#define PMIC_ARB_CHANNEL_UNIT   0x1000ULL
+#define PMIC_ARB_CHNL_STRIDE    0x8000u
+#define PMIC_ARB_CNFG_SIZE      0x3000
+#define PMIC_ARB_EE             0               /* qcom,ee = 0 (apps) */
+
+/* ---------------------------------------------------------------- registers */
+
+#define PMIC_ARB_CMD            0x00
+#define PMIC_ARB_CONFIG         0x04
+#define PMIC_ARB_STATUS         0x08
+#define PMIC_ARB_WDATA0         0x10
+#define PMIC_ARB_RDATA0         0x18
+
+#define PMIC_ARB_STATUS_DONE    0x1u
+#define PMIC_ARB_STATUS_FAIL    0x2u
+#define PMIC_ARB_STATUS_DENIED  0x4u
+#define PMIC_ARB_STATUS_DROPPED 0x8u
+
+#define PMIC_ARB_VERSION        0x000
+#define PMIC_ARB_APID_MAP(n)    (0x800 + 4 * (n))
+#define PMIC_ARB_APID_MAP_N     512u
+#define PMIC_ARB_PPID_SHIFT     8
+#define PMIC_ARB_PPID_MASK      0xfffu
+#define PMIC_ARB_OWNER(n)       (0x700 + 4 * (n))
+#define PMIC_ARB_EE_MASK        0x7u
+
+#define SPMI_OP_WRITE           14u
+#define SPMI_OP_READ            15u
+
+/*
+ * Poll budget: PMIC_ARB_TIMEOUT_US = 100 in the driver, with udelay(1) between
+ * reads. A stalled bus must be abandoned in ~100 us, not spun on for
+ * milliseconds, or the SoC watchdog turns the failure into a silent reset.
+ */
+#define PMIC_ARB_TIMEOUT_US     100u
+#define PMIC_ARB_UDELAY_TICKS   1u
+
+/* -------------------------------------------------------------- PM8998 LDO6 */
+
+#define PM8998_SID              0
+#define PM8998_LDO6_BASE        0x4500
+#define PM8998_LDO6_TYPE        (PM8998_LDO6_BASE + 0x04)
+#define PM8998_LDO6_SUBTYPE     (PM8998_LDO6_BASE + 0x05)
+#define PM8998_LDO6_RANGE       (PM8998_LDO6_BASE + 0x40)
+#define PM8998_LDO6_SET         (PM8998_LDO6_BASE + 0x41)
+#define PM8998_LDO6_MODE        (PM8998_LDO6_BASE + 0x45)
+#define PM8998_LDO6_ENABLE      (PM8998_LDO6_BASE + 0x46)
+/* PMOS LDO: range 3 starts at 1.5 V in 25 mV steps -> 12 = 1.80 V */
+#define PM8998_LDO6_RANGE_VAL   3u
+#define PM8998_LDO6_SET_VAL     12u
+#define SPMI_REG_ENABLE_BIT     0x80u
+#define SPMI_REG_MODE_HPM       0x80u
+
+/* ------------------------------------------------------------------- state */
+
+static struct {
+	volatile uint32_t *core;
+	volatile uint32_t *cnfg;
+	volatile uint32_t *chnls;       /* one 4 KiB page, remapped per channel */
+	uint32_t chnls_unit;
+	uint32_t apid;
+	int mapped;
+} pmic = {
+	.chnls_unit = 0xffffffffu,
+};
+
+static inline uint32_t
+pmic_rd_core(uint32_t off)
+{
+	return pmic.core[off / 4];
+}
+
+static void
+pmic_settle(uint32_t ticks)
+{
+	for (uint32_t t = 0; t < ticks; t++) {
+		for (volatile uint32_t i = 0; i < 2000; i++) {
+			__asm__ volatile("yield" ::: "memory");
+		}
+	}
+}
+
+/* ----------------------------------------------------------- channel access */
+
+static uint32_t
+pmic_chnl_offset(uint32_t apid)
+{
+	return PMIC_ARB_CHNL_STRIDE * apid + 0x1000u * PMIC_ARB_EE;
+}
+
+/*
+ * Map the page holding `apid`'s TX channel. Returns 0, or ENOMEM if the map
+ * failed.
+ */
+static int
+pmic_map_channel(uint32_t apid)
+{
+	uint32_t off = pmic_chnl_offset(apid);
+	uint32_t unit = off / (uint32_t)PMIC_ARB_CHANNEL_UNIT;
+
+	if (unit == pmic.chnls_unit) {
+		return 0;
+	}
+	pmic.chnls = (volatile uint32_t *)ml_io_map(
+	    PMIC_ARB_CHNLS_BASE + unit * PMIC_ARB_CHANNEL_UNIT,
+	    PMIC_ARB_CHANNEL_UNIT);
+	if (pmic.chnls == NULL) {
+		pmic.chnls_unit = 0xffffffffu;
+		return ENOMEM;
+	}
+	pmic.chnls_unit = unit;
+	return 0;
+}
+
+static inline uint32_t
+pmic_chnl_reg(uint32_t apid, uint32_t reg)
+{
+	uint32_t base = pmic_chnl_offset(apid) -
+	    pmic.chnls_unit * (uint32_t)PMIC_ARB_CHANNEL_UNIT;
+
+	return pmic.chnls[(base + reg) / 4];
+}
+
+static inline void
+pmic_chnl_set(uint32_t apid, uint32_t reg, uint32_t v)
+{
+	uint32_t base = pmic_chnl_offset(apid) -
+	    pmic.chnls_unit * (uint32_t)PMIC_ARB_CHANNEL_UNIT;
+
+	pmic.chnls[(base + reg) / 4] = v;
+	__asm__ volatile("dmb sy" ::: "memory");
+}
+
+/* --------------------------------------------------------------- APID lookup */
+
+/*
+ * Walk core + 0x800 .. core + 0xffc for the APID carrying `ppid`.
+ * Returns the APID, or -1. A PPID that only matches on the high nibble is
+ * reported and rejected: acting on it wrote another peripheral's register while
+ * looking successful (v80/v81).
+ */
+static int
+pmic_find_apid(uint32_t ppid, uint32_t *entry)
+{
+	uint32_t n;
+
+	for (n = 0; n < PMIC_ARB_APID_MAP_N; n++) {
+		uint32_t v = pmic_rd_core(PMIC_ARB_APID_MAP(n));
+		uint32_t got;
+
+		if (v == 0) {
+			continue;
+		}
+		got = (v >> PMIC_ARB_PPID_SHIFT) & PMIC_ARB_PPID_MASK;
+		if (got == ppid) {
+			if (entry != NULL) {
+				*entry = v;
+			}
+			printf("SAGIT PMIC: apid_map hit n=%u ppid=0x%x entry=0x%x\n",
+			    n, got, v);
+			return (int)n;
+		}
+		/*
+		 * Print only the entries whose PPID high nibble matches the target:
+		 * for 0x45 that is the 0x4x page, where an LDO of PM8998 would live.
+		 * Keeps the log short and still answers "is 0x45 here at all?".
+		 */
+		if (((got >> 4) & 0xfu) == ((ppid >> 4) & 0xfu)) {
+			printf("SAGIT PMIC: near n=%u ppid=0x%x (rejected)\n",
+			    n, got);
+		}
+	}
+	return -1;
+}
+
+/*
+ * Confirm the APID may be written by our EE. Returns 0 when it may, EPERM when
+ * it belongs to another EE (writing it would hang the core), or 0 when the cnfg
+ * window is unavailable (nothing to check with).
+ */
+static int
+pmic_check_owner(uint32_t apid, uint32_t *owner_out)
+{
+	uint32_t owner;
+
+	if (pmic.cnfg == NULL) {
+		return 0;
+	}
+	owner = pmic.cnfg[PMIC_ARB_OWNER(apid) / 4];
+	if (owner_out != NULL) {
+		*owner_out = owner;
+	}
+	printf("SAGIT PMIC: apid 0x%x owner raw=0x%x ee=%u\n",
+	    apid, owner, owner & PMIC_ARB_EE_MASK);
+	if ((owner & PMIC_ARB_EE_MASK) != PMIC_ARB_EE) {
+		return EPERM;
+	}
+	return 0;
+}
+
+/* ------------------------------------------------------------ one transfer */
+
+/*
+ * One SPMI register write of one byte.
+ *
+ * The sequence mirrors u-boot's spmi-msm and pmic_arb_write_cmd():
+ *   CONFIG = 0 (leave IRQ mode), WDATA0 = payload, CMD = command, poll STATUS.
+ * v86 tested this without clearing CONFIG and the line never took effect.
+ */
+static int
+pmic_write_byte(uint32_t apid, uint32_t reg, uint32_t val, uint32_t *status)
+{
+	uint32_t cmd = (SPMI_OP_WRITE << 27) | ((reg & 0xffu) << 4) | 0u;
+	uint32_t st = 0xffffffffu;
+	int rc;
+
+	rc = pmic_map_channel(apid);
+	if (rc != 0) {
+		return rc;
+	}
+
+	pmic_chnl_set(apid, PMIC_ARB_CONFIG, 0u);
+	pmic_chnl_set(apid, PMIC_ARB_WDATA0, val & 0xffu);
+	pmic_chnl_set(apid, PMIC_ARB_CMD, cmd);
+
+	for (uint32_t i = 0; i < PMIC_ARB_TIMEOUT_US; i++) {
+		st = pmic_chnl_reg(apid, PMIC_ARB_STATUS);
+		if (st & PMIC_ARB_STATUS_DONE) {
+			break;
+		}
+		pmic_settle(PMIC_ARB_UDELAY_TICKS);
+	}
+	if (status != NULL) {
+		*status = st;
+	}
+	if (!(st & PMIC_ARB_STATUS_DONE)) {
+		return ETIMEDOUT;
+	}
+	if (st & (PMIC_ARB_STATUS_FAIL | PMIC_ARB_STATUS_DENIED |
+	    PMIC_ARB_STATUS_DROPPED)) {
+		return EIO;
+	}
+	return 0;
+}
+
+/*
+ * One SPMI register read of one byte through the observer window. Returns the
+ * byte, or -1 on failure.
+ */
+static int
+pmic_read_byte(uint32_t apid, uint32_t reg)
+{
+	volatile uint32_t *obs;
+	uint32_t off = pmic_chnl_offset(apid);
+	uint32_t cmd = (SPMI_OP_READ << 27) | ((reg & 0xffu) << 4) | 0u;
+	uint32_t st = 0xffffffffu;
+
+	obs = (volatile uint32_t *)ml_io_map(PMIC_ARB_OBSVR_BASE + off,
+	    PMIC_ARB_CHANNEL_UNIT);
+	if (obs == NULL) {
+		return -1;
+	}
+	obs[PMIC_ARB_CONFIG / 4] = 0u;
+	obs[PMIC_ARB_CMD / 4] = cmd;
+	__asm__ volatile("dmb sy" ::: "memory");
+
+	for (uint32_t i = 0; i < PMIC_ARB_TIMEOUT_US; i++) {
+		st = obs[PMIC_ARB_STATUS / 4];
+		if (st & PMIC_ARB_STATUS_DONE) {
+			break;
+		}
+		pmic_settle(PMIC_ARB_UDELAY_TICKS);
+	}
+	if (!(st & PMIC_ARB_STATUS_DONE)) {
+		return -1;
+	}
+	if (st & (PMIC_ARB_STATUS_FAIL | PMIC_ARB_STATUS_DENIED |
+	    PMIC_ARB_STATUS_DROPPED)) {
+		return -1;
+	}
+	return (int)(obs[PMIC_ARB_RDATA0 / 4] & 0xffu);
+}
+
+/* ------------------------------------------------------------- entry point */
+
+int
+sagit_pmic_ldo6_on(struct sagit_pmic_report *rep)
+{
+	uint32_t st = 0;
+	uint32_t entry = 0;
+	uint32_t ppid;
+	int apid;
+	int rc;
+	int v;
+
+	if (pmic.mapped == 0) {
+		pmic.core = (volatile uint32_t *)ml_io_map(PMIC_ARB_CORE_BASE,
+		    PMIC_ARB_CORE_SIZE);
+		if (pmic.core == NULL) {
+			printf("SAGIT PMIC: ml_io_map(core) failed\n");
+			return ENOMEM;
+		}
+		pmic.cnfg = (volatile uint32_t *)ml_io_map(PMIC_ARB_CNFG_BASE,
+		    PMIC_ARB_CNFG_SIZE);
+		pmic.mapped = 1;
+	}
+
+	if (rep != NULL) {
+		rep->version = pmic_rd_core(PMIC_ARB_VERSION);
+	}
+	if (rep != NULL && (rep->version == 0 || rep->version == 0xffffffffu)) {
+		printf("SAGIT PMIC: arbiter version 0x%x, giving up\n",
+		    rep->version);
+		return ENODEV;
+	}
+	printf("SAGIT PMIC: version=0x%x, looking up ppid\n",
+	    rep != NULL ? rep->version : 0u);
+
+	/* LDO6 ENABLE is sid 0, address 0x4546 -> PPID 0x45. */
+	ppid = ((PM8998_SID & 0xfu) << 8) | ((PM8998_LDO6_ENABLE >> 8) & 0xffu);
+	apid = pmic_find_apid(ppid, &entry);
+	if (rep != NULL) {
+		rep->apid = (apid < 0) ? 0xffffffffu : (uint32_t)apid;
+		rep->map_entry = entry;
+	}
+	if (apid < 0) {
+		printf("SAGIT PMIC: no apid for ppid=0x%x\n", ppid);
+		return ENOENT;
+	}
+	pmic.apid = (uint32_t)apid;
+
+	rc = pmic_check_owner(pmic.apid, rep != NULL ? &rep->owner : NULL);
+	if (rc != 0) {
+		printf("SAGIT PMIC: apid 0x%x not ours, refusing to write\n",
+		    pmic.apid);
+		return rc;
+	}
+
+	/* Program the set point first, then enable. */
+	(void)pmic_write_byte(pmic.apid, PM8998_LDO6_RANGE,
+	    PM8998_LDO6_RANGE_VAL, NULL);
+	(void)pmic_write_byte(pmic.apid, PM8998_LDO6_SET,
+	    PM8998_LDO6_SET_VAL, NULL);
+	pmic_settle(2);
+
+	rc = pmic_write_byte(pmic.apid, PM8998_LDO6_ENABLE, SPMI_REG_ENABLE_BIT,
+	    &st);
+	if (rep != NULL) {
+		rep->enable_status = st;
+		rep->enable_rc = (uint32_t)rc;
+	}
+
+	/* MODE: read-modify-write so the pin-ctrl follow bits survive. */
+	v = pmic_read_byte(pmic.apid, PM8998_LDO6_MODE);
+	if (rep != NULL) {
+		rep->mode_before = (v < 0) ? PMIC_RB_FAILED : (uint32_t)v;
+	}
+	(void)pmic_write_byte(pmic.apid, PM8998_LDO6_MODE,
+	    (v < 0) ? SPMI_REG_MODE_HPM : ((uint32_t)v | SPMI_REG_MODE_HPM),
+	    &st);
+	if (rep != NULL) {
+		rep->mode_status = st;
+	}
+	pmic_settle(3);
+
+	/*
+	 * Read everything back. A DONE status only says the arbiter finished a
+	 * bus cycle; only the register contents show whether the PMIC took it.
+	 * TYPE/SUBTYPE identify the peripheral itself.
+	 */
+	if (rep != NULL) {
+		v = pmic_read_byte(pmic.apid, PM8998_LDO6_TYPE);
+		rep->type_rb = (v < 0) ? PMIC_RB_FAILED : (uint32_t)v;
+		v = pmic_read_byte(pmic.apid, PM8998_LDO6_SUBTYPE);
+		rep->subtype_rb = (v < 0) ? PMIC_RB_FAILED : (uint32_t)v;
+		v = pmic_read_byte(pmic.apid, PM8998_LDO6_RANGE);
+		rep->range_rb = (v < 0) ? PMIC_RB_FAILED : (uint32_t)v;
+		v = pmic_read_byte(pmic.apid, PM8998_LDO6_SET);
+		rep->set_rb = (v < 0) ? PMIC_RB_FAILED : (uint32_t)v;
+		v = pmic_read_byte(pmic.apid, PM8998_LDO6_ENABLE);
+		rep->enable_rb = (v < 0) ? PMIC_RB_FAILED : (uint32_t)v;
+		v = pmic_read_byte(pmic.apid, PM8998_LDO6_MODE);
+		rep->mode_rb = (v < 0) ? PMIC_RB_FAILED : (uint32_t)v;
+	}
+	return 0;
+}
+
+#endif /* SAGIT */
diff --git a/bsd/dev/sagit_pmic.h b/bsd/dev/sagit_pmic.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sagit_pmic.h
--- /dev/null
+++ b/bsd/dev/sagit_pmic.h
@@ -0,0 +1,42 @@
+/*
+ * SAGIT PMIC: the result of the SPMI write that brings up the touch rail.
+ *
+ * Kept in its own header so sagit_i2c.c can report the outcome in its panic
+ * string without pulling in any SPMI detail.
+ */
+#ifndef _BSD_DEV_SAGIT_PMIC_H_
+#define _BSD_DEV_SAGIT_PMIC_H_
+
+#include <sys/types.h>
+
+/* Value used when a register read failed. */
+#define PMIC_RB_FAILED  0xffffffffu
+
+struct sagit_pmic_report {
+	uint32_t version;       /* arbiter version word (core + 0x000) */
+	uint32_t apid;          /* APID for LDO6, or PMIC_RB_FAILED */
+	uint32_t map_entry;     /* raw APID map word that matched */
+	uint32_t owner;         /* APID ownership table word */
+	uint32_t enable_status; /* STATUS after the ENABLE write */
+	uint32_t mode_status;   /* STATUS after the MODE write */
+	uint32_t enable_rc;     /* 0 = the ENABLE transfer completed */
+	uint32_t mode_before;   /* MODE before the read-modify-write */
+	/* read-backs (PMIC_RB_FAILED when the read itself failed) */
+	uint32_t enable_rb;
+	uint32_t mode_rb;
+	uint32_t range_rb;
+	uint32_t set_rb;
+	uint32_t type_rb;
+	uint32_t subtype_rb;
+
+	/* Legacy fields still reported by the I2C probe's panic string. */
+	uint32_t addr;
+	uint32_t enable_rc_dup;
+	uint32_t mode_rc;
+	uint32_t rb_status;
+	uint32_t chnl_unit;
+};
+
+int sagit_pmic_ldo6_on(struct sagit_pmic_report *rep);
+
+#endif /* _BSD_DEV_SAGIT_PMIC_H_ */
diff --git a/bsd/dev/sagit_smem.c b/bsd/dev/sagit_smem.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sagit_smem.c
--- /dev/null
+++ b/bsd/dev/sagit_smem.c
@@ -0,0 +1,266 @@
+/*
+ * SAGIT: probe whether SMEM is usable from this kernel.
+ *
+ * WHY THIS EXISTS
+ * ---------------
+ * v89 proved that PM8998's LDO6 cannot be reached over SPMI: the APID -> PPID
+ * table contains no entry for PPID 0x45, and upstream agrees -- pm8998's rails
+ * are RPM/SMD resources ({ "l6", QCOM_SMD_RPM_LDOA, 6, ... } in
+ * qcom_smd-regulator.c), while qcom_spmi-regulator.c has no pm8998 table at
+ * all. The PMIC is driven by the RPM firmware, so switching that rail on means
+ * talking to the RPM over G-Link.
+ *
+ * G-Link needs, in this order: SMEM (to find the FIFOs), the RPM message RAM,
+ * the APCS mailbox to knock, and GIC SPI 168 for the reply. Before writing any
+ * of that, this probe answers the only question that matters:
+ *
+ *   can this kernel, at bsd_init() time, map and read SMEM at all?
+ *
+ * If SMEM is not reachable here then the whole RPM path is out of reach too,
+ * and no amount of protocol code would help -- so it is worth one boot to know.
+ *
+ * SMEM layout (drivers/soc/qcom/smem.c, struct smem_header):
+ *
+ *   0x000  smem_proc_comm proc_comm[4]      16 * u32  = 0x40
+ *   0x040  u32 version[32]
+ *   0x0c0  u32 initialized                  == 1 (boolean, smem.c:725)
+ *   0x0c4  u32 free_offset
+ *   0x0c8  u32 available
+ *   0x0cc  u32 reserved
+ *   0x0d0  smem_global_entry toc[512]        { u32 identifier; u32 offset; }
+ *
+ * The offsets above are the driver's: 4 * sizeof(struct smem_proc_comm) = 0x40
+ * and 4 * 32 = 0x80 more to reach `initialized`. (Struct sizes verified against
+ * smem.c's smem_proc_comm: u16 command, u16 status, u32 data[2] = 12 bytes,
+ * but it is padded to 16 by the compiler, so 4 * 16 = 0x40.)
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <machine/machine_routines.h>
+#include <libkern/libkern.h>
+
+#include "sagit_smem.h"
+
+extern void *phystokv(vm_offset_t pa);
+/* osfmk/arm/machine_routines.h provides these, but they are not exported to
+ * BSD: every driver has to declare its own extern (the v92 lesson). */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size,
+    uint32_t flags);
+/* osfmk/arm/memory_types.h: coherent/normal cache attributes. Using the
+ * default (cacheable) attribute is what lets us read DRAM that the bootloader
+ * wrote: ml_io_map()'s VM_WIMG_IO maps DRAM as Device (pmap.c:5649) and reads
+ * come back as zero. */
+#define SAGIT_WIMG_DEFAULT 0x2u     /* VM_WIMG_DEFAULT = VM_MEM_COHERENT */
+/* osfmk/arm64/arm_vm_init.c: the physmap window phystokv() accepts. */
+extern vm_offset_t gPhysBase;
+extern vm_size_t real_phys_size;
+
+#if defined(SAGIT)
+
+/*
+ * Map a physical RAM address for shared-memory access.
+ *
+ * Two traps, both already hit:
+ *
+ *  - phystokv() PANICS outside its window (v91):
+ *        phystokv: illegal PA: 0x86000000; phys base 0x10000000, size 0xd7e0000
+ *    XNU's physmap here covers ~216 MiB from 0x10000000, and SMEM lives at
+ *    0x86000000.
+ *  - ml_io_map() on DRAM is mapped as Device memory by pmap.c, so reads of
+ *    shared memory come back as 0 (v90).
+ *
+ * So translate only inside the window. Outside it, map with the DEFAULT
+ * (coherent, cacheable) attribute rather than VM_WIMG_IO: pmap.c:5649
+ * downgrades VM_WIMG_IO on DRAM to a Device mapping, which is why v90/v94
+ * read zeros from an initialised SMEM. VM_MEM_COHERENT gives a normal
+ * cached alias and lets the bootloader's writes become visible.
+ */
+#define SMEM_PROBE_WINDOW       0x200000u
+
+void *
+sagit_smem_ram_ptr(vm_offset_t pa)
+{
+	if (real_phys_size != 0 && pa >= gPhysBase &&
+	    (pa - gPhysBase) < real_phys_size) {
+		return phystokv(pa);
+	}
+	return (void *)ml_io_map_unmappable(pa, SMEM_PROBE_WINDOW,
+	    SAGIT_WIMG_DEFAULT);
+}
+
+/*
+ * The physmap window XNU ended up with.
+ *
+ * This is the interesting number: v91 reported "phys base 0x10000000, size
+ * 0xd7e0000" while the payload and ADT both carry 0x100000000 / 0xbd7c0000.
+ * A SAGIT BOOTARGS line printed in arm_init scrolls off the frame buffer, so
+ * the values are exported here and carried in the probe's panic string instead.
+ */
+void
+sagit_smem_physmap(vm_offset_t *base, vm_size_t *size)
+{
+	if (base != NULL) {
+		*base = gPhysBase;
+	}
+	if (size != NULL) {
+		*size = real_phys_size;
+	}
+}
+
+/* /soc/qcom,smem@86000000 in live.dtb */
+#define SAGIT_SMEM_BASE         0x86000000ULL
+#define SAGIT_SMEM_SIZE         0x200000ULL
+/* /soc/rpm-memory@0x778000, compatible qcom,rpm-code-ram */
+#define SAGIT_RPM_MSG_BASE      0x778000ULL
+#define SAGIT_RPM_MSG_SIZE      0x7000ULL   /* DT: glink-rpm-native-xprt reg */
+#define RPM_TOC_MAGIC           0x67727430u /* "grt0" */
+
+/* Upstream smem.c:725 checks `header->initialized != 1` -- it is a boolean,
+ * NOT the "SMEM" string. The shim probe read 1 at 0x0c0, confirming this. */
+#define SMEM_INITIALIZED        1u
+#define SMEM_TOC_OFFSET         0xd0u
+#define SMEM_TOC_ENTRIES        512u
+#define SMEM_ENTRY_SMEM         1u              /* SMEM_HEAP_INFO */
+/*
+ * G-Link native transport items. msm8998 uses glink-rpm (the mailbox flavour),
+ * whose FIFOs live in the RPM message RAM at 0x778000 rather than in SMEM, but
+ * these item ids are what a SMEM-based marker/descriptor would be called and
+ * are worth reporting: qcom_glink_smem.c defines exactly these numbers.
+ */
+#define SMEM_ENTRY_RPM_DESC     478u            /* XPRT_DESCRIPTOR */
+#define SMEM_ENTRY_RPM_FIFO0    479u            /* XPRT_FIFO_0 */
+#define SMEM_ENTRY_RPM_FIFO1    480u            /* XPRT_FIFO_1 */
+
+#define SMEM_PROBE_ENTRIES      SAGIT_SMEM_TOC_MAX  /* slots copied to the report */
+
+/*
+ * Read the SMEM header and a few table entries. Everything it learns goes into
+ * the report so the I2C probe can put it in its panic string; nothing here
+ * pokes the RPM yet.
+ */
+int
+sagit_smem_probe(struct sagit_smem_report *rep)
+{
+	volatile uint32_t *smem;
+	uint32_t hdr_ok;
+	uint32_t found = 0;
+
+	if (rep == NULL) {
+		return EINVAL;
+	}
+	memset(rep, 0, sizeof(*rep));
+
+	/*
+	 * SMEM lives in ordinary DRAM, so it must be read through the physmap --
+	 * NOT through ml_io_map().
+	 *
+	 * v90 mapped it with ml_io_map and read magic = 0x0 from a region that is
+	 * definitely initialised. osfmk/arm/pmap/pmap.c explains why:
+	 *
+	 *     case VM_WIMG_IO:
+	 *         // Map DRAM addresses with VM_WIMG_IO as Device-GRE instead of
+	 *         // Device-nGnRnE. ...
+	 *         if (is_dram_addr(pa)) {
+	 *             pte = ARM_PTE_ATTRINDX(CACHE_ATTRINDX_POSTED_COMBINED_REORDERED);
+	 *
+	 * i.e. asking for IO attributes on DRAM gives posted/combined Device
+	 * memory, whose reads are not coherent with normal cached memory -- the
+	 * shared-memory table another core wrote is invisible that way.
+	 *
+	 * phystokv() returns the cached physmap alias, which is what normal RAM
+	 * (and everything the bootloader wrote there) needs.
+	 */
+	smem = (volatile uint32_t *)sagit_smem_ram_ptr(SAGIT_SMEM_BASE);
+	if (smem == NULL) {
+		rep->map_rc = ENOMEM;
+		printf("SAGIT SMEM: phystokv(0x%llx) failed\n",
+		    (uint64_t)SAGIT_SMEM_BASE);
+		return ENOMEM;
+	}
+	rep->map_rc = 0;
+
+	/* magic at 0x0c0 */
+	hdr_ok = smem[0x0c0 / 4];
+	rep->magic = hdr_ok;
+	if (hdr_ok != SMEM_INITIALIZED) {
+		printf("SAGIT SMEM: initialized=0x%x (want 1)\n", hdr_ok);
+		return EINVAL;
+	}
+
+	rep->free_offset = smem[0x0c4 / 4];
+	rep->available = smem[0x0c8 / 4];
+
+	/*
+	 * Walk the table. An entry is { identifier, offset }; offset is relative
+	 * to the SMEM base. Report the first few so the log shows the table is
+	 * real, and note whether the RPM G-Link item is present at all -- that
+	 * is the item the RPM transport would need.
+	 */
+	for (uint32_t i = 0; i < SMEM_TOC_ENTRIES; i++) {
+		uint32_t id = smem[(SMEM_TOC_OFFSET + i * 8) / 4];
+		uint32_t off = smem[(SMEM_TOC_OFFSET + i * 8 + 4) / 4];
+
+		if (id == 0) {
+			continue;
+		}
+		if (id == SMEM_ENTRY_RPM_DESC) {
+			rep->rpm_item_offset = off;
+		}
+		if (id == SMEM_ENTRY_RPM_FIFO0 || id == SMEM_ENTRY_RPM_FIFO1) {
+			rep->rpm_fifo_seen++;
+		}
+		if (found < SMEM_PROBE_ENTRIES) {
+			rep->entries[found].id = id;
+			rep->entries[found].offset = off;
+			found++;
+		}
+	}
+	rep->found = found;
+
+	printf("SAGIT SMEM: ok magic=0x%x free=0x%x avail=0x%x entries=%u rpm_item=0x%x\n",
+	    rep->magic, rep->free_offset, rep->available, rep->found,
+	    rep->rpm_item_offset);
+	for (uint32_t i = 0; i < found && i < 8; i++) {
+		printf("SAGIT SMEM: toc[%u] id=%u off=0x%x\n",
+		    i, rep->entries[i].id, rep->entries[i].offset);
+	}
+
+	return 0;
+}
+
+/*
+ * Can the RPM message RAM be mapped? This is the second prerequisite; it is
+ * kept separate so a failure clearly points at the RAM rather than at SMEM.
+ */
+int
+sagit_smem_probe_rpm_ram(struct sagit_rpm_ram_report *rep)
+{
+	volatile uint32_t *ram;
+	volatile uint32_t *toc;
+
+	/* Ordinary DRAM: cached alias via smem_ram_ptr (see sagit_smem_probe). */
+	ram = (volatile uint32_t *)sagit_smem_ram_ptr(SAGIT_RPM_MSG_BASE);
+	if (ram == NULL) {
+		printf("SAGIT SMEM: rpm-ram map failed\n");
+		return ENOMEM;
+	}
+	/* TOC is the last 256 bytes of the RAM (qcom_glink_rpm.c). */
+	toc = ram + (SAGIT_RPM_MSG_SIZE - 0x100) / 4;
+	if (rep != NULL) {
+		__asm__ volatile("dsb sy" ::: "memory");
+		rep->toc_magic = toc[0];
+		rep->toc_count = toc[1];
+		rep->w0 = ram[0];
+		rep->w1 = ram[1];
+		rep->w2 = ram[2];
+	}
+	printf("SAGIT SMEM: rpm-ram toc=0x%x count=%u w0=0x%x w1=0x%x w2=0x%x\n",
+	    rep ? rep->toc_magic : 0, rep ? rep->toc_count : 0,
+	    rep ? rep->w0 : 0, rep ? rep->w1 : 0, rep ? rep->w2 : 0);
+	return 0;
+}
+
+#endif /* SAGIT */
diff --git a/bsd/dev/sagit_smem.h b/bsd/dev/sagit_smem.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sagit_smem.h
--- /dev/null
+++ b/bsd/dev/sagit_smem.h
@@ -0,0 +1,47 @@
+/*
+ * SAGIT SMEM: the result of the shared-memory probe.
+ *
+ * Kept separate from sagit_pmic.h so the I2C probe can report either or both
+ * without depending on each other.
+ */
+#ifndef _BSD_DEV_SAGIT_SMEM_H_
+#define _BSD_DEV_SAGIT_SMEM_H_
+
+#include <sys/types.h>
+
+#define SAGIT_SMEM_TOC_MAX      64
+
+struct sagit_smem_toc {
+	uint32_t id;
+	uint32_t offset;
+};
+
+struct sagit_smem_report {
+	int map_rc;             /* 0 = ml_io_map(SMEM) succeeded */
+	uint32_t magic;         /* smem_header.initialized; 0x494d4553 is good */
+	uint32_t free_offset;
+	uint32_t available;
+	uint32_t found;         /* entries copied into `entries` */
+	uint32_t total_entries; /* non-zero TOC entries seen */
+	uint32_t rpm_item_offset; /* offset of the G-Link descriptor item, 0 if absent */
+	uint32_t rpm_fifo_seen;   /* how many of the G-Link FIFO items exist */
+	struct sagit_smem_toc entries[SAGIT_SMEM_TOC_MAX];
+};
+
+int sagit_smem_probe(struct sagit_smem_report *rep);
+
+/* Raw RPM message RAM words, read through the cached alias, for the panic
+ * string. TOC magic lives at the last 256 bytes of the 0x7000-byte RAM. */
+struct sagit_rpm_ram_report {
+	uint32_t toc_magic;     /* expect 0x67727430 "grt0" when coherent */
+	uint32_t toc_count;
+	uint32_t w0, w1, w2;    /* first words of the RAM */
+};
+int sagit_smem_probe_rpm_ram(struct sagit_rpm_ram_report *rep);
+/* Cached (coherent) alias for an arbitrary physical DRAM address, for
+ * shared-memory access that phystokv() cannot cover. */
+void *sagit_smem_ram_ptr(vm_offset_t pa);
+/* The physmap window XNU is running with (gPhysBase / real_phys_size). */
+void sagit_smem_physmap(vm_offset_t *base, vm_size_t *size);
+
+#endif /* _BSD_DEV_SAGIT_SMEM_H_ */
diff --git a/bsd/dev/sagit_glink.c b/bsd/dev/sagit_glink.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sagit_glink.c
--- /dev/null
+++ b/bsd/dev/sagit_glink.c
@@ -0,0 +1,655 @@
+/*
+ * SAGIT: minimal G-Link over RPM message RAM, from the XNU BSD layer.
+ *
+ * Port of Linux drivers/soc/qcom/qcom_glink_rpm.c + qcom_glink_native.c and
+ * U-Boot drivers/soc/qcom/smd-rpm.c (Igor Opaniuk 2026). Only what is needed
+ * to vote PM8998 LDO6 ("ldoa":6, the Synaptics S3330 touch vdd rail) on.
+ *
+ * The RPM message RAM at 0x778000 is NOT in XNU's physmap window, so all
+ * access goes through sagit_smem_ram_ptr() -- a VM_MEM_COHERENT cached alias
+ * (v97 proved this works: TOC magic "grt0" was read from the BSD layer).
+ *
+ * Layout (verified against the DT and the v97 panic string):
+ *   msg RAM          0x778000, size 0x7000
+ *   TOC              msg_ram + 0x7000 - 0x100, magic 0x67727430 "grt0"
+ *   TOC entries      { id, offset, size }, id "ap2r"=TX (AP->RPM), "r2ap"=RX
+ *   each FIFO        [tail u32][head u32][data...] at entry offset
+ *   GLINK message    {cmd:u16,param1:u16,param2:u32} (+ data for TX_DATA)
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <stddef.h>
+#include <machine/machine_routines.h>
+
+#include "sagit_smem.h"
+#include "sagit_glink.h"
+
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer (same as UFS). */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#if defined(SAGIT)
+
+#define MSG_RAM_BASE     0x778000ULL
+#define MSG_RAM_SIZE     0x7000ULL
+
+/*
+ * APCS IPC "doorbell". Writing the TX head index alone is NOT enough: the RPM
+ * (an MCU) only re-reads its message RAM when it takes an interrupt, and that
+ * interrupt is raised by the AP writing this register. See msm8998.dtsi
+ * (apcs_glb: mailbox@17911000, glink-edge mboxes = <&apcs_glb 0>) and Linux
+ * drivers/mailbox/qcom-apcs-ipc-mailbox.c: msm8994_apcs_data.offset = 8,
+ * send_data writes BIT(cell). U-Boot's smd-rpm.c does the same via mbox_send().
+ *
+ * This is MMIO, so it must go through ml_io_map() (device mapping) -- using the
+ * physmap/cached alias here would poke a cache line instead of the register.
+ */
+#define APCS_IPC_BASE    0x17911000ULL
+#define APCS_IPC_SIZE    0x1000ULL
+#define APCS_IPC_OFF     0x8ULL
+#define APCS_IPC_RPM_BIT 0
+
+#define RPM_TOC_SIZE      0x100ULL
+#define RPM_TOC_MAGIC     0x67727430ULL  /* "grt0" */
+#define RPM_TOC_HDR       0x08ULL
+#define RPM_TOC_ENTRY_SZ  0x0cULL
+#define RPM_TX_FIFO_ID    0x61703272ULL  /* "ap2r" */
+#define RPM_RX_FIFO_ID    0x72326170ULL  /* "r2ap" */
+
+#define GLINK_VERSION_1   1
+#define GCMD_VERSION      0
+#define GCMD_VERSION_ACK  1
+#define GCMD_OPEN         2
+#define GCMD_CLOSE        3
+#define GCMD_OPEN_ACK     4
+#define GCMD_INTENT       5
+#define GCMD_RX_DONE      6
+#define GCMD_RXI_REQ      7
+#define GCMD_RXI_REQ_ACK  8
+#define GCMD_TX_DATA      9
+#define GCMD_CLOSE_ACK    11
+#define GCMD_TX_DATA_CONT 12
+#define GCMD_READ_NOTIF   13
+#define GCMD_RX_DONE_REUSE 14
+#define GCMD_SIGNALS      15
+
+#define CHAN_NAME        "rpm_requests"
+#define CHAN_LCID        1
+
+#define RPM_SVC_REQUEST  0x00716572UL   /* "req\0" */
+#define RPM_KEY_SWEN     0x6e657773UL   /* "swen" */
+#define RPM_KEY_UV       0x00007675UL   /* "uv"   */
+#define RPM_RES_LDOA     0x616f646cUL   /* "ldoa" */
+#define LDO6_ID          6
+#define LDO6_UV          1800000UL
+#define RPM_MSG_TYPE_ID  0x2367736dUL   /* "msg#" */
+#define RPM_MSG_TYPE_ERR 0x00727265UL   /* "err\0" */
+
+/*
+ * Polling budget. rx_pump() now refreshes only the queued bytes (typically one
+ * or two cache lines) instead of the whole ring, and it resyncs instead of
+ * re-scanning forever, so a spin is cheap again. 20k spins is ~4-40 ms of wall
+ * time -- plenty for the RPM (an MCU answering in tens of microseconds) yet
+ * safely under the boot watchdog.
+ */
+#define SPIN_BUDGET      20000ULL
+
+struct gl_fifo {
+	volatile uint32_t *tail;
+	volatile uint32_t *head;
+	uint8_t *data;
+	uint32_t len;
+};
+
+static struct gl_fifo tx_f, rx_f;
+static uint16_t remote_cid;
+static int remote_open, open_acked, req_acked;
+static uint32_t seen_msg_id;
+static struct sagit_glink_report *g_rep;
+
+/*
+ * physmap (phystokv) is a *write-back cached* normal-memory mapping. A plain
+ * store plus "dsb sy" does NOT make the data visible in DDR: the store may sit
+ * dirty in L1/L2, and the RPM (a separate Cortex-M3 that reads DDR directly,
+ * outside the CPU's coherency domain) would never see it. That is exactly why
+ * v98 sent VERSION and got no reply.
+ *
+ * So every access to the shared FIFO has to be wrapped in explicit cache
+ * maintenance: clean (dc cvac) after we produce, invalidate (dc civac) before
+ * we consume. Lines are 64 bytes; ranges are rounded outwards.
+ */
+#define GLINK_CACHELINE  64ULL
+
+static inline void
+glink_cache_clean(uintptr_t start, size_t len)
+{
+	uintptr_t a = start & ~(GLINK_CACHELINE - 1);
+	uintptr_t e = (start + len + GLINK_CACHELINE - 1) & ~(GLINK_CACHELINE - 1);
+
+	for (; a < e; a += GLINK_CACHELINE) {
+		__asm__ volatile("dc cvac, %0" :: "r"(a) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static inline void
+glink_cache_inval(uintptr_t start, size_t len)
+{
+	uintptr_t a = start & ~(GLINK_CACHELINE - 1);
+	uintptr_t e = (start + len + GLINK_CACHELINE - 1) & ~(GLINK_CACHELINE - 1);
+
+	for (; a < e; a += GLINK_CACHELINE) {
+		__asm__ volatile("dc civac, %0" :: "r"(a) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/* Cached alias: raw access; callers pair it with glink_cache_* maintenance. */
+static inline uint32_t rd32(volatile uint32_t *a)
+{
+	uint32_t v = *a;
+	__asm__ volatile("dsb sy" ::: "memory");
+	return v;
+}
+static inline void wr32(volatile uint32_t *a, uint32_t v)
+{
+	*a = v;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/*
+ * Ring the RPM. 0x17911008 is the APCS IPC command register for the RPM cell;
+ * write BIT(0). Mapped lazily once through the device window.
+ */
+/*
+ * Ring the RPM. 0x17911008 is the APCS IPC command register for the RPM cell;
+ * write BIT(0). Mapped once through the device window.
+ */
+static volatile uint32_t *apcs_ipc;
+
+static int
+glink_doorbell_init(void)
+{
+	vm_offset_t va;
+
+	if (apcs_ipc != NULL) {
+		return 1;
+	}
+	va = ml_io_map(APCS_IPC_BASE, APCS_IPC_SIZE);
+	if (va == 0) {
+		return 0;
+	}
+	apcs_ipc = (volatile uint32_t *)va;
+	return 1;
+}
+
+static int
+glink_doorbell(void)
+{
+	if (!glink_doorbell_init()) {
+		return 0;
+	}
+	apcs_ipc[APCS_IPC_OFF / 4] = (1u << APCS_IPC_RPM_BIT);
+	__asm__ volatile("dsb sy" ::: "memory");
+	return 1;
+}
+
+static int str_eq(const char *a, const char *b)
+{
+	while (*a && *b) {
+		if (*a != *b) return 0;
+		a++; b++;
+	}
+	return *a == *b;
+}
+static uint32_t str_len(const char *s)
+{
+	uint32_t n = 0;
+	while (s[n]) n++;
+	return n;
+}
+
+/* Correct ring semantics. head==tail => empty (both directions). */
+static inline uint32_t fifo_data(volatile uint32_t *head, volatile uint32_t *tail, uint32_t len)
+{
+	uint32_t h = rd32(head), t = rd32(tail);
+	return (h + len - t) % len;
+}
+static inline uint32_t fifo_space(volatile uint32_t *head, volatile uint32_t *tail, uint32_t len)
+{
+	return len - 1 - fifo_data(head, tail, len);
+}
+
+/* Parse the RPM TOC and locate the TX/RX FIFOs. Linux qcom_glink_rpm.c:190. */
+static int
+glink_parse_toc(uint8_t *msg, struct sagit_glink_report *rep)
+{
+	volatile uint32_t *toc = (volatile uint32_t *)(msg + MSG_RAM_SIZE - RPM_TOC_SIZE);
+	uint32_t magic = rd32(&toc[0]);
+	uint32_t count = rd32(&toc[1]);
+	uint32_t i;
+
+	rep->toc_magic = magic;
+	if (magic != RPM_TOC_MAGIC)
+		return -1;
+	if (count > (RPM_TOC_SIZE - RPM_TOC_HDR) / RPM_TOC_ENTRY_SZ)
+		return -2;
+	rep->nentries = count;
+
+	for (i = 0; i < count; i++) {
+		volatile uint32_t *e = &toc[2] + i * (RPM_TOC_ENTRY_SZ / 4);
+		uint32_t id = rd32(&e[0]);
+		uint32_t off = rd32(&e[1]);
+		uint32_t sz = rd32(&e[2]);
+		struct gl_fifo *f = NULL;
+
+		if (id == RPM_TX_FIFO_ID) f = &tx_f;
+		else if (id == RPM_RX_FIFO_ID) f = &rx_f;
+		else continue;
+		if (off > MSG_RAM_SIZE || sz < 8 || off + sz > MSG_RAM_SIZE)
+			continue;
+		f->tail = (volatile uint32_t *)(msg + off);
+		f->head = (volatile uint32_t *)(msg + off + 4);
+		f->data = (uint8_t *)(msg + off + 8);
+		f->len = sz - 8;
+		if (rep != NULL) {
+			if (f == &tx_f) { rep->tx_off = off; rep->tx_sz = sz; }
+			else            { rep->rx_off = off; rep->rx_sz = sz; }
+		}
+	}
+	if (tx_f.data == NULL || rx_f.data == NULL)
+		return -3;
+	rep->tx_len = tx_f.len;
+	rep->rx_len = rx_f.len;
+	return 0;
+}
+
+/* Write hdr+data to the TX FIFO (padded to 8), advance head. */
+static int
+tx_write(const void *hdr, uint32_t hlen, const void *data, uint32_t dlen)
+{
+	uint8_t buf[64];
+	uint32_t len = (hlen + dlen + 7) & ~7u;
+	uint32_t h, i, word;
+	uint64_t spin;
+
+	if (len > sizeof(buf) || len >= tx_f.len)
+		return -1;
+	for (i = 0; i < sizeof(buf); i++) buf[i] = 0;
+	for (i = 0; i < hlen; i++) buf[i] = ((const uint8_t *)hdr)[i];
+	for (i = 0; i < dlen; i++) buf[hlen + i] = ((const uint8_t *)data)[i];
+
+	for (spin = 0; ; spin++) {
+		/* Re-read the RPM-owned tail out of DDR before deciding space. */
+		glink_cache_inval((uintptr_t)tx_f.tail, 4);
+		if (fifo_space(tx_f.head, tx_f.tail, tx_f.len) >= len) break;
+		if (spin > SPIN_BUDGET) return -2;
+	}
+	h = rd32(tx_f.head);
+	for (i = 0; i < len; i += 4) {
+		word = (uint32_t)buf[i] | ((uint32_t)buf[i+1] << 8) |
+		       ((uint32_t)buf[i+2] << 16) | ((uint32_t)buf[i+3] << 24);
+		wr32((volatile uint32_t *)(tx_f.data + h), word);
+		h += 4;
+		if (h >= tx_f.len) h = 0;
+	}
+	/* Push the payload to DDR, then publish head (the notification). */
+	glink_cache_clean((uintptr_t)tx_f.data, tx_f.len);
+	wr32(tx_f.head, h);
+	glink_cache_clean((uintptr_t)tx_f.head, 4);
+	/* ...and interrupt the RPM, so it actually looks at the FIFO. */
+	if (glink_doorbell() && g_rep != NULL) {
+		g_rep->state |= SAGIT_GLINK_ST_DOORBELL;
+	}
+	return 0;
+}
+
+struct glmsg { uint16_t cmd, param1; uint32_t param2; } __attribute__((packed));
+
+static int send_cmd(uint16_t cmd, uint16_t p1, uint32_t p2)
+{
+	struct glmsg m = { cmd, p1, p2 };
+	return tx_write(&m, sizeof(m), NULL, 0);
+}
+
+static void rx_peek(uint32_t off, void *dst, uint32_t n)
+{
+	uint32_t t = rd32(rx_f.tail);
+	uint32_t pos = (t + off) % rx_f.len;
+	uint8_t *b = dst;
+	while (n) {
+		uint32_t w = rd32((volatile uint32_t *)(rx_f.data + pos));
+		uint32_t k = n < 4 ? n : 4;
+		uint32_t i;
+		for (i = 0; i < k; i++) b[i] = (uint8_t)(w >> (8 * i));
+		b += k; n -= k; pos += 4;
+		if (pos >= rx_f.len) pos = 0;
+	}
+}
+
+static void rx_advance(uint32_t n)
+{
+	uint32_t t = rd32(rx_f.tail);
+	wr32(rx_f.tail, (t + n) % rx_f.len);
+	/* Let the RPM see that we consumed, so it can refill. */
+	glink_cache_clean((uintptr_t)rx_f.tail, 4);
+}
+
+/*
+ * Walk the key/value-style entries of an RPM response.
+ *
+ * v101 hung here: "off += 8 + ((ml + 3) & ~3u)" wraps around when the length
+ * field is garbage (ml = 0xFFFFFFF8 makes the add 0x100000000, which is 0 in
+ * 32 bits), so off never advances and this loops forever. Any entry that does
+ * not fit inside the payload is now treated as the end of the response.
+ */
+static void
+parse_rpm_ack(uint8_t *payload, uint32_t ch)
+{
+	uint32_t off;
+
+	for (off = 8; off + 8 <= ch; ) {
+		uint32_t mt = payload[off] | ((uint32_t)payload[off+1] << 8) |
+		              ((uint32_t)payload[off+2] << 16) | ((uint32_t)payload[off+3] << 24);
+		uint32_t ml = payload[off+4] | ((uint32_t)payload[off+5] << 8) |
+		              ((uint32_t)payload[off+6] << 16) | ((uint32_t)payload[off+7] << 24);
+
+		if (ml > ch - off - 8) {
+			break;      /* truncated or garbage length: stop, do not wrap */
+		}
+		if (mt == RPM_MSG_TYPE_ID && ml >= 4) {
+			seen_msg_id = payload[off+8] | ((uint32_t)payload[off+9] << 8) |
+			              ((uint32_t)payload[off+10] << 16) | ((uint32_t)payload[off+11] << 24);
+			req_acked = 1;
+			if (g_rep) g_rep->ack_kind = 1;
+		} else if (mt == RPM_MSG_TYPE_ERR) {
+			if (g_rep) {
+				g_rep->ack_kind = 2;
+				g_rep->ack_err = ml >= 4 ?
+				    (payload[off+8] | ((uint32_t)payload[off+9] << 8) |
+				     ((uint32_t)payload[off+10] << 16) | ((uint32_t)payload[off+11] << 24)) : 0;
+			}
+		}
+		off += 8 + ((ml + 3) & ~3u);
+	}
+}
+
+/* Drain GLINK control messages from RX. */
+static void
+rx_pump(void)
+{
+	uint32_t guard, h, t;
+
+	/* RPM owns rx head: refresh its line and bail if nothing arrived. */
+	glink_cache_inval((uintptr_t)rx_f.head, 8);
+	h = rd32(rx_f.head);
+	t = rd32(rx_f.tail);
+
+	/*
+	 * A head outside the ring means the FIFO state is corrupt (or never
+	 * initialised): with a garbage head, "head != tail" is always true and
+	 * the drain loop below can never reach the head, so every poll re-scans
+	 * the whole ring. Reset both indices; the handshake has already
+	 * completed by the time this can matter.
+	 */
+	if (h >= rx_f.len || t >= rx_f.len) {
+		wr32(rx_f.head, 0);
+		wr32(rx_f.tail, 0);
+		glink_cache_clean((uintptr_t)rx_f.tail, 8);
+		return;
+	}
+	if (h == t) return;                     /* true empty */
+
+	/* Refresh only what is queued, not the whole 1.7 KB ring. */
+	{
+		uint32_t need = h > t ? h - t : rx_f.len - t + h;
+		uint32_t part1 = rx_f.len - t;
+
+		if (need > rx_f.len) need = rx_f.len;
+		if (need <= part1) {
+			glink_cache_inval((uintptr_t)rx_f.data + t, need);
+		} else {
+			glink_cache_inval((uintptr_t)rx_f.data + t, part1);
+			glink_cache_inval((uintptr_t)rx_f.data, need - part1);
+		}
+	}
+
+	for (guard = 0; guard < 24; guard++) {
+		struct glmsg m;
+		uint32_t avail;
+
+		avail = fifo_data(rx_f.head, rx_f.tail, rx_f.len);
+		if (avail < sizeof(m)) return;
+		rx_peek(0, &m, sizeof(m));
+		switch (m.cmd) {
+		case GCMD_VERSION:
+			rx_advance(sizeof(m));
+			if (m.param1)
+				send_cmd(GCMD_VERSION_ACK, GLINK_VERSION_1, 0);
+			break;
+		case GCMD_VERSION_ACK:
+			rx_advance(sizeof(m));
+			if (g_rep) g_rep->state |= SAGIT_GLINK_ST_VERSION;
+			break;
+		case GCMD_OPEN: {
+			uint32_t extra = m.param2 & 0xffff;
+			uint32_t n = extra < 31 ? extra : 31;
+			char name[32];
+			uint32_t i;
+
+			extra = (extra + 7) & ~7u;
+			if (extra > rx_f.len || avail < sizeof(m) + extra) return;
+			for (i = 0; i < sizeof(name); i++) name[i] = 0;
+			rx_peek(sizeof(m), name, n);
+			rx_advance(sizeof(m) + extra);
+			if (str_eq(name, CHAN_NAME)) {
+				remote_cid = m.param1;
+				remote_open = 1;
+			}
+			break;
+		}
+		case GCMD_OPEN_ACK:
+			rx_advance(sizeof(m));
+			if (m.param1 == CHAN_LCID) open_acked = 1;
+			break;
+		case GCMD_INTENT:
+			/* param2 is a pair count; reject absurd values outright. */
+			if (m.param2 > rx_f.len / 8) {
+				rx_advance(sizeof(m));
+				break;
+			}
+			rx_advance(sizeof(m) + m.param2 * 8);
+			break;
+		case GCMD_READ_NOTIF:
+			rx_advance(sizeof(m));
+			break;
+		case GCMD_TX_DATA:
+		case GCMD_TX_DATA_CONT: {
+			uint32_t ch, total;
+			uint8_t payload[64];
+
+			if (avail < 16) return;
+			rx_peek(8, &ch, 4);
+			total = 16 + ((ch + 7) & ~7u);
+			if (ch > rx_f.len || avail < total) return;
+			if (ch <= sizeof(payload)) {
+				rx_peek(16, payload, ch);
+				parse_rpm_ack(payload, ch);
+			}
+			rx_advance(total);
+			break;
+		}
+		default:
+			rx_advance(sizeof(m));
+			break;
+		}
+	}
+
+	/*
+	 * 24 messages without emptying the ring means tail and head disagree: the
+	 * messages were mis-framed (tail drifted off a boundary) or the ring is
+	 * being filled faster than we drain. Snap tail to head and drop the rest,
+	 * otherwise the next poll re-reads the same bytes forever. Everything we
+	 * need from the handshake has already been parsed at this point.
+	 */
+	{
+		uint32_t h2 = rd32(rx_f.head);
+		if (h2 < rx_f.len) {
+			wr32(rx_f.tail, h2);
+			glink_cache_clean((uintptr_t)rx_f.tail, 4);
+		}
+	}
+}
+
+static int wait_until(int (*done)(void))
+{
+	uint64_t spin;
+	for (spin = 0; spin < SPIN_BUDGET; spin++) {
+		rx_pump();
+		if (done()) return 0;
+	}
+	return -1;
+}
+static int is_remote_open(void) { return remote_open; }
+static int is_open_ack(void)    { return open_acked; }
+
+/* Send one RPM resource request and wait for the matching "msg#" ack. */
+static int
+rpm_request(uint32_t msg_id, uint32_t type, uint32_t id, uint32_t key, uint32_t value)
+{
+	uint8_t pkt[48];
+	uint32_t kv[3] = { key, 4, value };
+	uint32_t rlen = 20, dlen = 12, n = 0, w;
+	uint32_t i, j;
+	uint64_t spin;
+
+	w = RPM_SVC_REQUEST;
+	for (i = 0; i < 4; i++) pkt[n++] = (uint8_t)(w >> (8*i));
+	w = rlen + dlen;
+	for (i = 0; i < 4; i++) pkt[n++] = (uint8_t)(w >> (8*i));
+	w = msg_id;
+	for (i = 0; i < 4; i++) pkt[n++] = (uint8_t)(w >> (8*i));
+	w = 0;  /* ACTIVE state */
+	for (i = 0; i < 4; i++) pkt[n++] = (uint8_t)(w >> (8*i));
+	w = type;
+	for (i = 0; i < 4; i++) pkt[n++] = (uint8_t)(w >> (8*i));
+	w = id;
+	for (i = 0; i < 4; i++) pkt[n++] = (uint8_t)(w >> (8*i));
+	w = dlen;
+	for (i = 0; i < 4; i++) pkt[n++] = (uint8_t)(w >> (8*i));
+	for (i = 0; i < 3; i++) {
+		w = kv[i];
+		for (j = 0; j < 4; j++) pkt[n++] = (uint8_t)(w >> (8*j));
+	}
+	{
+		struct { struct glmsg m; uint32_t chunk, left; } gh;
+		gh.m.cmd = GCMD_TX_DATA; gh.m.param1 = CHAN_LCID; gh.m.param2 = 0;
+		gh.chunk = n; gh.left = 0;
+		if (tx_write(&gh, sizeof(gh), pkt, n)) {
+			printf("SAGIT GLINK: req%u tx failed\n", msg_id);
+			return -1;
+		}
+	}
+	printf("SAGIT GLINK: req%u tx ok\n", msg_id);
+	req_acked = 0;
+	for (spin = 0; spin < SPIN_BUDGET; spin++) {
+		rx_pump();
+		if (req_acked && seen_msg_id == msg_id) return 0;
+	}
+	printf("SAGIT GLINK: req%u no ack seen=%u kind=%u\n",
+	    msg_id, seen_msg_id, g_rep ? g_rep->ack_kind : 0);
+	return -2;
+}
+
+int
+sagit_glink_ldo6_on(struct sagit_glink_report *rep)
+{
+	uint8_t *msg;
+	int rc;
+	struct { struct glmsg m; char name[32]; } open_req;
+	uint32_t nl, i;
+
+	if (rep != NULL) {
+		g_rep = rep;
+		rep->rc = -99;
+		rep->toc_magic = rep->nentries = rep->tx_len = rep->rx_len = 0;
+		rep->tx_off = rep->tx_sz = rep->rx_off = rep->rx_sz = 0;
+		rep->tx_head0 = rep->tx_tail0 = rep->rx_head0 = rep->rx_tail0 = 0;
+		rep->remote_cid = 0; rep->state = 0; rep->ack_msg_id = 0;
+		rep->ack_kind = rep->ack_err = 0;
+	} else {
+		g_rep = NULL;
+	}
+	remote_open = open_acked = req_acked = 0;
+	remote_cid = 0;
+	seen_msg_id = 0;
+	tx_f.data = rx_f.data = NULL;
+
+	msg = (uint8_t *)sagit_smem_ram_ptr(MSG_RAM_BASE);
+	if (msg == NULL)
+		return -100;
+
+	rc = glink_parse_toc(msg, rep);
+	if (rc)
+		return rc;
+	if (rep) rep->state |= SAGIT_GLINK_ST_TOC;
+	printf("SAGIT GLINK: apcs map=%d\n", glink_doorbell_init());
+
+	/*
+	 * Record what the RPM left behind, then reset our own indices to 0 --
+	 * exactly what Linux qcom_glink_rpm_probe() and U-Boot glink_rpm_connect()
+	 * do (writel(0, tx.head); writel(0, rx.tail)). Our side owns tx.head and
+	 * rx.tail; the RPM owns the other two.
+	 */
+	glink_cache_inval((uintptr_t)tx_f.tail, 8);
+	glink_cache_inval((uintptr_t)rx_f.tail, 8);
+	if (rep != NULL) {
+		rep->tx_head0 = rd32(tx_f.head);
+		rep->tx_tail0 = rd32(tx_f.tail);
+		rep->rx_head0 = rd32(rx_f.head);
+		rep->rx_tail0 = rd32(rx_f.tail);
+	}
+	wr32(tx_f.head, 0);
+	wr32(rx_f.tail, 0);
+	glink_cache_clean((uintptr_t)tx_f.tail, 8);
+	/* Breadcrumb: if the phone hangs, this is the last stage that ran. */
+	printf("SAGIT GLINK: toc tx/rx=%u/%u had h=%u/%u\n",
+	    tx_f.len, rx_f.len,
+	    rep ? rep->tx_head0 : 0, rep ? rep->rx_head0 : 0);
+
+	if (send_cmd(GCMD_VERSION, GLINK_VERSION_1, 0))
+		return -4;
+	printf("SAGIT GLINK: ver sent db=%d\n",
+	    (rep && (rep->state & SAGIT_GLINK_ST_DOORBELL)) ? 1 : 0);
+	if (wait_until(is_remote_open))
+		return -5;
+	printf("SAGIT GLINK: remote open cid=%u\n", remote_cid);
+	if (rep) { rep->remote_cid = remote_cid; rep->state |= SAGIT_GLINK_ST_OPEN_REM; }
+
+	/* Acknowledge the RPM's open, and open our end of rpm_requests. */
+	if (send_cmd(GCMD_OPEN_ACK, remote_cid, 0))
+		return -6;
+	for (i = 0; i < sizeof(open_req); i++) ((uint8_t *)&open_req)[i] = 0;
+	nl = str_len(CHAN_NAME) + 1;
+	open_req.m.cmd = GCMD_OPEN;
+	open_req.m.param1 = CHAN_LCID;
+	open_req.m.param2 = nl;
+	for (i = 0; i < nl; i++) open_req.name[i] = CHAN_NAME[i];
+	if (tx_write(&open_req, (nl + 7) & ~7u, NULL, 0))
+		return -7;
+	if (wait_until(is_open_ack))
+		return -8;
+	printf("SAGIT GLINK: open_ack ok\n");
+	if (rep) rep->state |= SAGIT_GLINK_ST_OPEN_ACK;
+
+	/* Vote LDO6: set 1.8V then enable. */
+	if (rpm_request(1, RPM_RES_LDOA, LDO6_ID, RPM_KEY_UV, LDO6_UV))
+		return -9;
+	printf("SAGIT GLINK: ldo6 uv acked\n");
+	if (rpm_request(2, RPM_RES_LDOA, LDO6_ID, RPM_KEY_SWEN, 1))
+		return -10;
+	printf("SAGIT GLINK: ldo6 swen acked\n");
+	if (rep) { rep->state |= SAGIT_GLINK_ST_REQ_ACK; rep->ack_msg_id = seen_msg_id; }
+	return 0;
+}
+
+#endif /* SAGIT */
diff --git a/bsd/dev/sagit_glink.h b/bsd/dev/sagit_glink.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sagit_glink.h
--- /dev/null
+++ b/bsd/dev/sagit_glink.h
@@ -0,0 +1,41 @@
+/*
+ * SAGIT: G-Link over RPM message RAM, used to vote PM8998 LDO6 (touch vdd).
+ *
+ * The Synaptics S3330's vdd rail is RPM resource "ldoa":6. Linux's
+ * synaptics_dsx driver calls regulator_enable(vdd) before its first I2C read.
+ * This XNU port has no RPM driver, so implement the minimal GLINK handshake +
+ * one resource request, reading the RPM message RAM through the cached alias
+ * (sagit_smem.c) -- the physmap window does NOT cover 0x778000.
+ */
+#ifndef _BSD_DEV_SAGIT_GLINK_H_
+#define _BSD_DEV_SAGIT_GLINK_H_
+
+#include <sys/types.h>
+
+/* Result of the LDO6 voting attempt, for the panic string. */
+struct sagit_glink_report {
+	int rc;                 /* 0 = ok, negative = step that failed */
+	uint32_t toc_magic;     /* "grt0" 0x67727430 when RAM is readable */
+	uint32_t nentries;      /* TOC entries */
+	uint32_t tx_len, rx_len;/* FIFO data-region lengths */
+	uint32_t tx_off, tx_sz; /* TX FIFO TOC entry: offset / size */
+	uint32_t rx_off, rx_sz; /* RX FIFO TOC entry: offset / size */
+	uint32_t tx_head0, tx_tail0; /* TX head/tail as read before any write */
+	uint32_t rx_head0, rx_tail0; /* RX head/tail as read before any read */
+	uint16_t remote_cid;    /* channel id the RPM opened */
+	uint32_t state;         /* bitmask of handshake milestones */
+	uint32_t ack_msg_id;    /* last ack seen */
+	uint32_t ack_kind;      /* 0=none, 1="msg#" ack, 2="err" */
+	uint32_t ack_err;       /* first 4 bytes of an "err" string */
+};
+
+#define SAGIT_GLINK_ST_TOC      0x01u
+#define SAGIT_GLINK_ST_VERSION  0x02u
+#define SAGIT_GLINK_ST_OPEN_REM 0x04u
+#define SAGIT_GLINK_ST_OPEN_ACK 0x08u
+#define SAGIT_GLINK_ST_REQ_ACK  0x10u
+#define SAGIT_GLINK_ST_DOORBELL 0x20u  /* APCS IPC mapped and rung at least once */
+
+int sagit_glink_ldo6_on(struct sagit_glink_report *rep);
+
+#endif /* _BSD_DEV_SAGIT_GLINK_H_ */
