diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -966,7 +966,41 @@
 		 */
 		{
 			extern int sagit_ufs_rootdev(dev_t * dev);
+			extern void sagit_i2c_touch_probe(void);
+			extern void sagit_i2c_set_stop_at(uint32_t);
 			dev_t ufs_dev = 0;
+
+#if defined(SAGIT)
+			/*
+			 * One-shot I2C probe, opt-in via the boot-arg
+			 * "sagit_touch=1". Every path exits through panic(), so
+			 * enabling it steals the boot until the link is proven --
+			 * which is the point: one screenshot then says exactly
+			 * which stage works.
+			 *
+			 * Uses PE_parse_boot_argn with a real destination buffer,
+			 * the same way bsd_init reads "rd" above. A bare
+			 * strstr(PE_boot_args(), ...) would not link: this kernel
+			 * declares no strstr for kernel code.
+			 */
+			int touch_probe = 0;
+			if (PE_parse_boot_argn("sagit_touch", &touch_probe,
+			    sizeof(touch_probe)) && touch_probe != 0) {
+				/*
+				 * sagit_tstop=N makes stage N panic on entry.
+				 * The board can freeze between two printf() calls
+				 * without resetting, so a screenshot alone cannot say
+				 * which stage was entered; panic() always prints.
+				 */
+				int touch_stop = 0;
+				PE_parse_boot_argn("sagit_tstop", &touch_stop,
+				    sizeof(touch_stop));
+				if (touch_stop > 0) {
+					sagit_i2c_set_stop_at((uint32_t)touch_stop);
+				}
+				sagit_i2c_touch_probe();
+			}
+#endif
 			if (SAGIT_UFS_PROBE == 1) {
 				panic("SAGIT probe 1: about to call sagit_ufs_rootdev");
 			}
