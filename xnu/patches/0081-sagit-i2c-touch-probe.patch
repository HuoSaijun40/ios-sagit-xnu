+			    sizeof(touch_probe)) && touch_probe != 0) {
+				/*
+				 * sagit_tstop=N makes stage N panic on entry.
+				 * The board can freeze between two printf() calls
+				 * without resetting, so a screenshot alone cannot say
+				 * which stage was entered; panic() always prints.
+				 */
+				int touch_stop = 0;
