diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index dae9e40..57da95b 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1409,14 +1409,17 @@ bsd_utaskbootstrap(void)
 	thread_t thread;
 	struct uthread *ut;
 
+	printf("SAGIT CL U1: bsd_utaskbootstrap entered\n");
 	/*
 	 * Clone the bootstrap process from the kernel process, without
 	 * inheriting either task characteristics or memory from the kernel;
 	 */
 	thread = cloneproc(TASK_NULL, NULL, kernproc, CLONEPROC_FLAGS_MEMSTAT_INTERNAL);
+	printf("SAGIT CL U2: cloneproc returned %p\n", (void *)thread);
 
 	/* Hold the reference as it will be dropped during shutdown */
 	initproc = proc_find(1);
+	printf("SAGIT CL U3: proc_find(1) -> %p\n", (void *)initproc);
 #if __PROC_INTERNAL_DEBUG
 	if (initproc == PROC_NULL) {
 		panic("bsd_utaskbootstrap: initproc not set");
@@ -1424,6 +1427,7 @@ bsd_utaskbootstrap(void)
 #endif
 
 	zalloc_first_proc_made();
+	printf("SAGIT CL U4: zalloc_first_proc_made done\n");
 
 	/*
 	 * Since we aren't going back out the normal way to our parent,
@@ -1431,14 +1435,18 @@ bsd_utaskbootstrap(void)
 	 */
 	proc_signalend(initproc, 0);
 	proc_transend(initproc, 0);
+	printf("SAGIT CL U5: signalend/transend done\n");
 
 	ut = (struct uthread *)get_bsdthread_info(thread);
 	ut->uu_sigmask = 0;
 	act_set_astbsd(thread);
+	printf("SAGIT CL U6: act_set_astbsd done, ut %p\n", (void *)ut);
 
 	ipc_task_enable(get_threadtask(thread));
+	printf("SAGIT CL U7: ipc_task_enable done\n");
 
 	task_clear_return_wait(get_threadtask(thread), TCRW_CLEAR_ALL_WAIT);
+	printf("SAGIT CL U8: task_clear_return_wait done\n");
 }
 
